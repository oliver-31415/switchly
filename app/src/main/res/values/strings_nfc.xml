    <!-- ====================================================== -->
    <!-- NFC action descriptions -->
    <!-- ====================================================== -->
    <string name="nfc_action_desc_enable">Writes a tag that enables Switchly.</string>
    <string name="nfc_action_desc_disable">Writes a tag that disables Switchly.</string>
    <string name="nfc_action_desc_toggle">Writes a tag that toggles Switchly ON/OFF.</string>
    <plurals name="nfc_action_desc_temp_disable">
        <item quantity="one">Writes a tag that disables Switchly for %1$d minute, then restores the previous state.</item>
        <item quantity="other">Writes a tag that disables Switchly for %1$d minutes, then restores the previous state.</item>
    </plurals>
    <plurals name="nfc_action_desc_temp_enable">
        <item quantity="one">Writes a tag that enables Switchly for %1$d minute, then restores the previous state.</item>
        <item quantity="other">Writes a tag that enables Switchly for %1$d minutes, then restores the previous state.</item>
    </plurals>
    <string name="nfc_action_desc_temp_disable_ask">Use “Ask when scanned” if you want to choose the break length each time. Great for short intentional unlocks without creating many tags.</string>
    <string name="nfc_action_desc_temp_enable_ask">Use “Ask when scanned” if you want to choose the blocking length each time. When the timer ends, Switchly restores the state from before the scan.</string>
    <plurals name="nfc_action_desc_reentry">
        <item quantity="one">Writes a Temporary settings unlock tag that unlocks Switchly settings for %1$d minute, then restores the previous state.</item>
        <item quantity="other">Writes a Temporary settings unlock tag that unlocks Switchly settings for %1$d minutes, then restores the previous state.</item>
    </plurals>
    <string name="nfc_action_desc_pair_uid">Use this NFC tag as a toggle without writing anything to it.</string>
    <string name="nfc_action_desc_pair_uid_disabled">Pair tag is disabled. Enable paired NFC tags in Blocking &amp; control toggles, then scan a tag to add its UID.</string>
