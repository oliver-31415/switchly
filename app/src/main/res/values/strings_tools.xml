    <!-- Info dialogs -->
    <!-- ====================================================== -->
    <string name="qr_info_title">QR code actions</string>
    <string name="qr_info_body">Create QR codes that run Switchly actions when scanned. QR codes can enable, disable, toggle, or temporarily change Switchly.\n\nFor stricter setups, keep only QR enabled in Control modes and disable the other channels you do not want to use.</string>
    <string name="manage_barcodes_info_title">Barcode actions</string>
    <string name="manage_barcodes_info_body">Saved barcodes turn printed or physical codes into Switchly actions. You can use them to enable, disable, toggle, or temporarily change Switchly without editing the app.\n\nFor stronger friction, place the barcode away from your phone and use Temporary Disable or Temporary Enable with “Ask when scanned”.</string>
    <string name="paired_tags_info_title">Paired NFC tags</string>
    <string name="paired_tags_info_body">Paired tags are for UID-only/read-only NFC tags or setups where you want per-tag limits. Writable Switchly action tags do not need to be paired.\n\nUse this page when the tag should be recognized by its NFC ID, when you want a default action for a read-only tag, or when you want daily-use/cooldown limits.</string>

