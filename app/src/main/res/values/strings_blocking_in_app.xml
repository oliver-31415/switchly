    <string name="in_app_rules_title">In-app rules</string>

    <string name="in_app_rules_info_title">In-app rules</string>
    <string name="in_app_rules_info_body">In-app rules apply only to the selected profile.\n\nChoose a mode:\n• Block selected: Only selected sections are blocked.\n• Allow selected: Selected sections stay available; other supported sections of that app are blocked.\n\nStatus:\n• Available: Supported for the installed app version.\n• Experimental: May vary by app version, language, entry point, or device.\n• Disabled: The app is not installed or the rule cannot currently be used.\n• Coming soon: Planned, but not yet enforceable.\n\nSwitchly detects these sections using Accessibility. Changes to supported apps can affect detection.</string>
    <string name="in_app_rule_mode_title">In-app rule mode</string>
    <string name="in_app_rule_mode_block">Block selected</string>
    <string name="in_app_rule_mode_allow">Allow selected</string>
    <string name="in_app_rule_mode_block_summary">Switches mark sections that Switchly should block.</string>
    <string name="in_app_rule_mode_allow_summary">Only selected sections stay available. Other supported sections of that app are blocked once at least one section is selected.</string>
    <string name="in_app_rule_allow_confirm_title">Use Allow selected?</string>
    <string name="in_app_rule_allow_confirm_body_counted">With the currently installed apps, %1$s and %2$s. Apps without a selected section are not affected.</string>
