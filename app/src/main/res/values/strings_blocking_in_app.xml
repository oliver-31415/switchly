    <string name="in_app_rule_mode_allow">Allow selected</string>
    <string name="in_app_rule_mode_block_summary">Switches mark sections that Switchly should block.</string>
    <string name="in_app_rule_mode_allow_summary">Switches mark sections that stay allowed. Other supported sections for that app are blocked once at least one section is selected.</string>
