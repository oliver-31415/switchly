    <string name="in_app_blocking_title">In-app rules</string>

    <string name="in_app_rules_info_title">In-app rules</string>
    <string name="in_app_rules_info_body">In-app rules are profile-specific and apply only while this profile is active.\n\nRules are active as soon as selected sections exist for this profile. Use Block selected to block only selected sections, or Allow selected to allow selected sections and block the other supported sections for that app. Switchly uses Accessibility to detect supported in-app sections, so app UI changes can affect reliability.\n\nAvailable means the section is supported for the installed app version. Experimental means it works best-effort and may vary by app version, entry point, language, or device. Disabled means the app is not installed or the rule cannot be used right now. Coming soon means the section is listed as a planned rule but is not enforceable yet.</string>
    <string name="in_app_rule_mode_title">In-app rule mode</string>
