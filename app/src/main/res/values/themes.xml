<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =========================
         THEME: Base + compatibility alias
         ========================= -->
    <!-- Backwards-compatible alias (older builds referenced @style/Switchly as the app theme) -->
    <style name="Switchly" parent="Theme.Switchly" />

    <!-- Base application theme (day/default) -->
    <!-- Material 3 + Expressive: soft warm neutrals, generous corner radii, calm green accent -->
    <style name="Theme.Switchly" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Accent/primary colors -->
        <item name="colorPrimary">@color/accent_default_green</item>
        <item name="colorPrimaryVariant">@color/accent_default_green</item>
        <item name="colorSecondary">@color/accent_default_green</item>

        <!-- M3 container tokens derived from the accent (used by switches, chips, dialogs) -->
        <item name="colorPrimaryContainer">@color/accent_green_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_green_on_container</item>
        <item name="colorSecondaryContainer">@color/accent_green_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_green_on_container</item>

        <!-- Foqos-style warm neutral surfaces -->
        <item name="android:colorBackground">@color/foqos_bg</item>
        <item name="android:windowBackground">@color/foqos_bg</item>
        <item name="colorSurface">@color/foqos_surface</item>
        <item name="colorSurfaceVariant">@color/foqos_surface_variant</item>
        <item name="colorSurfaceContainer">@color/foqos_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/foqos_surface_container_high</item>
        <item name="colorOnSurface">@color/foqos_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/foqos_on_surface_variant</item>
        <item name="colorOutline">@color/foqos_outline</item>
        <item name="colorOutlineVariant">@color/foqos_outline_variant</item>

        <!-- Expressive shape ramp: soft, rounded, generous -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Switchly.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Switchly.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Switchly.Large</item>

        <!-- Preferences (PreferenceFragmentCompat) -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Global Material component styles -->
        <item name="materialButtonStyle">@style/Switchly.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Switchly.OutlinedButton</item>
        <item name="floatingActionButtonStyle">@style/Switchly.Fab</item>
        <item name="materialCardViewStyle">@style/Switchly.Card</item>

        <!-- Toolbar/ActionBar -->
        <item name="toolbarStyle">@style/Switchly.TopBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.ActionBar</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.Material3.Light</item>
        <item name="android:textColorPrimaryInverse">@android:color/white</item>

        <!--
            IMPORTANT:
            Do NOT apply the ExposedDropdownMenu TextInputLayout style globally.
            It causes crashes when a normal EditText is placed inside a TextInputLayout (Material requires an AutoCompleteTextView for exposed dropdowns).
            Use Switchly.DropdownLayout only on actual dropdown fields in XML.
        -->
        <item name="textInputStyle">@style/Switchly.TextInputLayout</item>
        <item name="autoCompleteTextViewStyle">@style/Switchly.AutoCompleteText</item>

        <!-- Dialog overlay -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Switchly.Dialog</item>
    </style>

    <!-- Dialog overlay that keeps controls in sync with the current accent theme. -->
    <style name="ThemeOverlay.Switchly.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorPrimary</item>
        <item name="colorAccent">?attr/colorPrimary</item>
    </style>

