        <item name="colorPrimaryVariant">@color/accent_teal</item>
        <item name="colorSecondary">@color/accent_teal</item>
    </style>

    <!-- Amber -->
    <style name="Theme.Switchly.Accent.Amber" parent="Theme.Switchly">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorPrimaryVariant">@color/accent_amber</item>
        <item name="colorSecondary">@color/accent_amber</item>
    </style>

    <!-- Gray -->
    <style name="Theme.Switchly.Accent.Gray" parent="Theme.Switchly">
        <item name="colorPrimary">@color/accent_gray</item>
        <item name="colorPrimaryVariant">@color/accent_gray</item>
        <item name="colorSecondary">@color/accent_gray</item>
    </style>

</resources>
