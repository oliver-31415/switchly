<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme (default = green accent) -->
    <style name="Theme.Switchly" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Accent / primary colors -->
        <item name="colorPrimary">@color/accent_default_green</item>
        <item name="colorPrimaryVariant">@color/accent_default_green</item>
        <item name="colorSecondary">@color/accent_default_green</item>

        <!-- Status bar etc. -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>

        <!-- Global Material component styles -->
        <item name="materialButtonStyle">@style/Switchly.Button</item>
        <item name="floatingActionButtonStyle">@style/Switchly.Fab</item>
        <item name="materialCardViewStyle">@style/Switchly.Card</item>

        <!-- Toolbar / ActionBar -->
        <item name="toolbarStyle">@style/Switchly.TopBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.MaterialComponents.ActionBar</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.MaterialComponents.Light</item>
        <item name="android:textColorPrimaryInverse">@android:color/white</item>

        <!-- Global styles for dropdown fields -->
        <item name="textInputStyle">@style/Switchly.DropdownLayout</item>
        <item name="autoCompleteTextViewStyle">@style/Switchly.DropdownText</item>
    </style>
    
    <!-- Blue -->
    <style name="Theme.Switchly.Accent.Blue" parent="Theme.Switchly">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_blue</item>
    </style>

    <!-- Orange -->
    <style name="Theme.Switchly.Accent.Orange" parent="Theme.Switchly">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorPrimaryVariant">@color/accent_orange</item>
        <item name="colorSecondary">@color/accent_orange</item>
    </style>

    <!-- Purple -->
    <style name="Theme.Switchly.Accent.Purple" parent="Theme.Switchly">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorPrimaryVariant">@color/accent_purple</item>
        <item name="colorSecondary">@color/accent_purple</item>
    </style>

    <!-- Red -->
    <style name="Theme.Switchly.Accent.Red" parent="Theme.Switchly">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorPrimaryVariant">@color/accent_red</item>
        <item name="colorSecondary">@color/accent_red</item>
    </style>

    <!-- Pink -->
    <style name="Theme.Switchly.Accent.Pink" parent="Theme.Switchly">
        <item name="colorPrimary">@color/accent_pink</item>
        <item name="colorPrimaryVariant">@color/accent_pink</item>
        <item name="colorSecondary">@color/accent_pink</item>
    </style>

    <!-- Teal -->
    <style name="Theme.Switchly.Accent.Teal" parent="Theme.Switchly">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryVariant">@color/accent_teal</item>
        <item name="colorSecondary">@color/accent_teal</item>
    </style>

    <!-- Amber -->
    <style name="Theme.Switchly.Accent.Amber" parent="Theme.Switchly">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorPrimaryVariant">@color/accent_amber</item>
        <item name="colorSecondary">@color/accent_amber</item>
    </style>

    <!-- Gray -->
    <style name="Theme.Switchly.Accent.Gray" parent="Theme.Switchly">
        <item name="colorPrimary">@color/accent_gray</item>
        <item name="colorPrimaryVariant">@color/accent_gray</item>
        <item name="colorSecondary">@color/accent_gray</item>
    </style>

</resources>
