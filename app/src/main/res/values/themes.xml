    <!-- =========================
         THEME: Base + compatibility alias
         ========================= -->
    <!-- Backwards-compatible alias (older builds referenced @style/Switchly as the app theme) -->
    <style name="Switchly" parent="Theme.Switchly" />

    <style name="Theme.Switchly" parent="Theme.Switchly.Base">
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Material 3 + Expressive: soft warm neutrals, generous corner radii, calm green accent -->
    <!-- Base application theme -->
    <!--
        Foqos restyle: Material 3 Expressive, self-contained token set.

        WHY self-contained: on Android 16/17 (verified: Pixel 10 Pro XL, Android 17)
        Material 1.13.0 materialThemeOverlay-wrapped ?attr lookups fail at night for
        attrs that are only present via the theme's INHERITED base chain
        ("Failed to resolve attribute" / ThemeEnforcement IllegalArgumentException).
        Carrying every M3 token as a direct item of this style sidesteps the bug.
        See docs/FOQOS_RESTYLE.md Pitfall #1.

        WHY Light parent (not DayNight): dark mode is provided by our own
        foqos_* / accent_*_container color tokens which have values-night variants,
        so the theme is identical in both modes and colors flip via resource config.
        This also avoids the same native resolution bug around DayNight theme copies.
    -->
    <style name="Theme.Switchly.Base" parent="Theme.Material3.Light.NoActionBar">

        <!-- Accent/primary colors -->
        <item name="colorPrimary">@color/accent_default_green</item>
        <item name="colorPrimaryVariant">@color/accent_default_green</item>
        <item name="colorSecondary">@color/accent_default_green</item>
        <item name="colorPrimaryContainer">@color/accent_green_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_green_on_container</item>
        <item name="colorSecondaryContainer">@color/accent_green_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_green_on_container</item>

        <!-- Foqos surfaces / backgrounds -->
        <item name="android:colorBackground">@color/foqos_bg</item>
        <item name="android:windowBackground">@color/foqos_bg</item>

        <!-- Framework text colors (foqos_* flip per config; fixes dark-mode gray text) -->
        <item name="android:textColorPrimary">@color/foqos_on_surface</item>
        <item name="android:textColorSecondary">@color/foqos_on_surface_variant</item>
        <item name="android:textColorTertiary">@color/foqos_on_surface_variant</item>
        <item name="android:textColorPrimaryInverse">@color/foqos_on_surface</item>
        <item name="android:textColorSecondaryInverse">@color/foqos_on_surface_variant</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Full Material 3 token set (self-contained; Foqos overrides applied) -->
