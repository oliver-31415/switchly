    <!-- ====================================================== -->
    <!-- Welcome and core concept -->
    <!-- ====================================================== -->
    <string name="onb_welcome_title">Welcome to Switchly</string>
    <string name="onb_welcome_desc">Build a setup that adds friction where you need it without making your whole phone harder to use.</string>
    <string name="onb_core_point_choose">Choose the apps, websites and in-app content you want each profile to manage.</string>
    <string name="onb_core_point_control">Control protection with buttons, schedules, NFC, QR, barcodes, widgets or tiles.</string>

    <!-- ====================================================== -->
    <!-- Usage report onboarding step -->
    <!-- ====================================================== -->
    <string name="onb_usage_report_title">Show your current usage</string>
    <string name="onb_usage_report_desc">Want to see more details before choosing apps? Allow Usage Access below and Switchly will add a private 7-day report as the next step. You can continue without it.</string>
    <string name="onb_usage_permission_status_ready">Ready · The 7-day report is now the next step</string>
    <string name="onb_usage_permission_status_optional">Optional · Tap to allow</string>
    <string name="onb_usage_report_private_title">Private on-device report</string>
    <string name="onb_usage_report_private_desc">Switchly reads Android usage data locally to build this preview. Nothing from the report is uploaded.</string>
    <string name="onb_usage_report_private_status">Adds a 7-day overview before app selection</string>

    <!-- ====================================================== -->
    <!-- Usage report preview -->
    <!-- ====================================================== -->
    <string name="onb_usage_preview_title">Your last 7 days</string>
    <string name="onb_usage_preview_desc">See where your time went, then use the top apps as a starting point for your blocking list.</string>
    <string name="onb_usage_preview_total">7-day total</string>
    <string name="onb_usage_preview_daily_average">Daily average</string>
    <string name="onb_usage_preview_top_apps">Your top 7 apps</string>
    <string name="onb_usage_preview_other_apps">Others</string>
    <string name="onb_usage_preview_empty_title">No recent usage yet</string>
    <string name="onb_usage_preview_empty_desc">Use your apps for a little while and open this page again. You can continue onboarding without this report.</string>

    <!-- ====================================================== -->
    <!-- Pick apps -->
    <!-- ====================================================== -->
    <string name="onb_pick_title">Pick apps to block</string>
    <string name="onb_pick_desc_required">Choose at least one app before continuing. Pick deliberately based on what you actually want Switchly to block.</string>
    <string name="onb_pick_action">Choose apps</string>
    <string name="onb_pick_point_goal">Choose apps based on the behavior you want to reduce or block.</string>
    <string name="onb_pick_point_system_apps">Some launcher, authentication, security and system apps are safer left unblocked unless you have tested them.</string>
    <string name="onb_pick_empty_title">No apps selected yet</string>
    <string name="onb_pick_empty_desc">Open the app picker and choose the apps Switchly should handle for this profile.</string>
    <string name="onb_pick_empty_status">Choose at least one app before starting.</string>
    <plurals name="onb_apps_picked_count">
        <item quantity="one">Change %1$d selected app</item>
        <item quantity="other">Change %1$d selected apps</item>
    </plurals>
    <string name="onb_required_pick_apps">Please choose and save at least one app before continuing.</string>

    <!-- ====================================================== -->
    <!-- Blocking controls -->
    <!-- ====================================================== -->
    <string name="onb_controls_title">Choose how blocking is controlled</string>
    <string name="onb_controls_desc">Choose how strict Switchly should be while blocking is active. You can keep it simple now and tighten it later.</string>
    <string name="onb_controls_action">Choose mode</string>
    <string name="onb_controls_selected">Mode selected</string>
    <string name="onb_controls_point_enable_disable">Choose which actions can enable or disable Switchly.</string>
    <string name="onb_controls_point_lock_edits">Restrict profile, schedule or app-list edits while active.</string>
    <string name="onb_required_controls">Please choose how Switchly should be controlled before continuing.</string>

    <!-- ====================================================== -->
    <!-- Permissions overview -->
    <!-- ====================================================== -->
    <string name="onb_permissions_hub_title">Permissions overview</string>
    <string name="onb_permissions_hub_mode_desc">Set up the permissions for %1$s. Accessibility and Usage Access are required to continue.</string>
    <string name="onb_required_permissions_hub">Please enable Accessibility and Usage Access before continuing. The other items can be set up now or later.</string>
    <string name="onb_perm_accessibility_title">Accessibility</string>
    <string name="onb_perm_accessibility_desc">Required for core app and website blocking.</string>
    <string name="onb_perm_usage_title">Usage Access</string>
    <string name="onb_perm_usage_desc">Reads local app activity for usage-aware blocking and statistics. The data stays on this device.</string>
    <string name="onb_perm_notifications_title">Notifications</string>
    <string name="onb_perm_notifications_desc">Only needed when notification blocking is enabled.</string>
    <string name="onb_perm_battery_title">Battery unrestricted</string>
    <string name="onb_perm_battery_desc">Helps Switchly stay reliable in the background.</string>
    <string name="onb_perm_triggers_title">Location, Wi-Fi and Bluetooth</string>
    <string name="onb_perm_triggers_desc">Only needed for location, Wi-Fi or Bluetooth schedules.</string>
    <string name="onb_perm_camera_title">Camera</string>
    <string name="onb_perm_camera_desc">Only needed for QR and barcode scanning.</string>
    <string name="onb_perm_exact_alarm_title">Exact alarms</string>
    <string name="onb_perm_exact_alarm_desc">Helps timed schedules run reliably.</string>
    <string name="onb_perm_nfc_title">Launch via NFC</string>
    <string name="onb_perm_nfc_desc">If you use NFC tags, Android may require Switchly to be allowed under Special app access &gt; Launch via NFC. Passive tags normally require the device to be unlocked.</string>
    <string name="onb_permission_status_ready">Ready</string>
    <string name="onb_permission_status_missing">Setup needed</string>
    <string name="onb_permission_status_manual">Check manually</string>

