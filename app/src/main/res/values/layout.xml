<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =========================
         THEME: Blocker variant
         ========================= -->
    <!-- Variant without ActionBar (overlay/blocker screens) -->
    <!-- Fully opaque, no edge-to-edge; used e.g. for BlockerActivity -->
    <style name="Theme.Switchly.Blocker" parent="Theme.Switchly">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.Switchly.None</item>
    </style>

    <!-- =========================
         SHAPE RAMP: Material 3 Expressive
         Soft, rounded, generous radii applied theme-wide
         ========================= -->
    <style name="ShapeAppearance.Switchly.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Switchly.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Switchly.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Animation.Switchly.None" parent="@android:style/Animation.Activity">        <item name="android:activityOpenEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:activityOpenExitAnimation">@anim/switchly_no_animation</item>
        <item name="android:activityCloseEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:activityCloseExitAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskOpenEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskOpenExitAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskCloseEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskCloseExitAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskToFrontEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskToFrontExitAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskToBackEnterAnimation">@anim/switchly_no_animation</item>
        <item name="android:taskToBackExitAnimation">@anim/switchly_no_animation</item>
    </style>

    <!-- =========================
         COMPONENT STYLES: Toolbar/buttons/cards/chips
         ========================= -->
    <!-- Unified top bar, uses current accent color -->
    <style name="Switchly.TopBar" parent="Widget.Material3.Toolbar">
        <!-- Background = current accent color -->
        <item name="android:background">?attr/colorPrimary</item>
        <item name="backgroundTint">?attr/colorPrimary</item>

        <!-- Title color -->
        <item name="titleTextColor">@android:color/white</item>

        <!-- Back arrow in light/dark appearance -->
        <item name="navigationIconTint">@android:color/white</item>
    </style>

    <!-- Standard buttons -->
    <!-- Expressive pill shape via full corner radius -->
    <style name="Switchly.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- Primary button alias -->
    <style name="Switchly.PrimaryButton" parent="Switchly.Button" />

    <style name="Switchly.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Switchly.OutlinedButton.CompactSegment" parent="Switchly.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Lightweight dialog/action buttons (no filled background) -->
    <style name="Switchly.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Floating Action Button -->
    <style name="Switchly.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
    </style>

    <!-- Card shape appearance -->
    <style name="ShapeAppearance.Switchly.Card" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Even rounder tiles (quick actions) -->
    <style name="ShapeAppearance.Switchly.Tile" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>

    <style name="Switchly.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.Switchly.Card</item>
        <!--
            M3 elevated-card state list animator uses ?attr/ motion references, which the
            framework's themeless state-list-animator path cannot resolve (crash in dark mode).
            Flat Foqos cards don't need press-elevation anyway. See docs/FOQOS_RESTYLE.md Pitfall #2.
        -->
        <item name="android:stateListAnimator">@null</item>
        <item name="cardBackgroundColor">@color/foqos_surface</item>
        <item name="strokeColor">@color/foqos_outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- Tile cards in the dashboard quick actions -->
    <style name="Switchly.TileCard" parent="Switchly.Card">
        <item name="shapeAppearance">@style/ShapeAppearance.Switchly.Tile</item>
        <item name="cardElevation">1dp</item>
    </style>

    <style name="Switchly.SectionHeader">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Small divider inside cards -->
    <style name="Switchly.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">@color/switchly_divider</item>
        <item name="dividerThickness">1dp</item>
    </style>
    <!-- Small badges -->
    <style name="Switchly.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/foqos_surface_variant</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small tile badge -->
    <style name="Switchly.TileBadge">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:minHeight">18dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Day picker chips -->
    <style name="Switchly.DayChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">999dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="chipStartPadding">9dp</item>
        <item name="chipEndPadding">9dp</item>
        <item name="textStartPadding">2dp</item>
        <item name="textEndPadding">2dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- =========================
         DROPDOWNS: TextInputLayout
         ========================= -->
    <!-- Default (non-dropdown) TextInputLayout styling used globally via theme -->
    <style name="Switchly.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="enforceTextAppearance" tools:ignore="MissingId">false</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <!-- Default (non-dropdown) AutoCompleteTextView styling used globally via theme -->
    <style name="Switchly.AutoCompleteText" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyLarge</item>
    </style>

    <!-- Layout container for exposed dropdown menus -->
    <style name="Switchly.DropdownLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="enforceTextAppearance" tools:ignore="MissingId">false</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintEnabled">true</item>
        <item name="hintTextAppearance">@style/Switchly.DropdownHint</item>
    </style>

    <!-- Hint text styling inside dropdowns -->
    <style name="Switchly.DropdownHint" parent="TextAppearance.Material3.BodySmall">
        <item name="android:lineHeight" tools:targetApi="28">14sp</item>
    </style>

    <!-- Text appearance for dropdown input field -->
    <style name="Switchly.DropdownText" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyLarge</item>
    </style>

</resources>
