    <string name="permissions_for_bluetooth_not_needed">Not needed (no Bluetooth rules)</string>
    <string name="accessibility_service_desc">Detects foreground-app changes so Switchly can block apps and enforce usage limits.</string>
    <string name="perm_location_title">Location permission</string>
    <string name="perm_location_why_wifi_ssid">To read the Wi-Fi name (SSID), Switchly needs the Wi-Fi permission. On Android 13 and newer, also allow Nearby Wi-Fi devices.</string>
    <string name="perm_location_denied_wifi_schedule">Location permission denied. Wi-Fi schedules may not work without this permission.</string>
    <string name="perm_bt_title">Nearby devices permission</string>
    <string name="perm_bt_why_needed">To detect connected Bluetooth devices for Bluetooth schedules, Android requires the “Nearby devices” permission.</string>
    <string name="perm_bt_denied_schedule">Bluetooth permission denied. Bluetooth schedules may not work without this permission.</string>
