    <!-- PERMISSIONS - Core and trigger permissions -->
    <string name="permissions_accessibility_title">Accessibility service</string>
    <string name="permissions_accessibility_desc">Required for reliable blocking: lets Switchly instantly detect opened apps and enforce your profiles.</string>
    <string name="permissions_usage_access_title">App usage access</string>
    <string name="permissions_usage_access_desc">Required for screen-time statistics and daily app limits. Enable “App usage data” access for Switchly.</string>
    <string name="permissions_battery_title">Battery optimization</string>
    <string name="permissions_battery_desc">Disable battery optimization so schedules and receivers can run reliably in the background.</string>
    <string name="permissions_battery_allowed">Allowed</string>
    <string name="permissions_battery_not_allowed">Disabled</string>
    <string name="permissions_battery_highest_available">Highest available enabled</string>
    <string name="permissions_exact_alarms_title">Exact alarms</string>
    <string name="permissions_exact_alarms_summary">Needed so time-based schedules can run reliably at the correct time.</string>
    <string name="permissions_exact_alarms_allowed">Allowed</string>
    <string name="permissions_exact_alarms_not_allowed">Not allowed</string>
    <string name="permissions_location_title">Location</string>
    <string name="permissions_location_desc">Required so Wi-Fi-based schedules can detect the connected network. For best reliability, set location access to “Allow all the time”.</string>
    <string name="permissions_bluetooth_title">Bluetooth (Nearby devices)</string>
    <string name="permissions_bluetooth_desc">Required for Bluetooth-based schedules (Android 12+).</string>
    <!-- PERMISSIONS - Notification-related permissions -->
    <string name="permissions_notifications_title">Notifications</string>
    <string name="permissions_notifications_desc">Required so Switchly can show status updates and reminders in the notification shade.</string>
    <string name="permissions_notification_access_title">Notification access</string>
    <string name="permissions_notification_access_desc">Required to hide notifications from apps blocked by your active profile (notification listener access).</string>
    <string name="toast_notification_listener_required">To hide blocked-app notifications, enable notification access for Switchly.</string>
    <!-- PERMISSIONS - OEM/autostart and helper buttons -->
    <string name="permissions_autostart_title">Auto-start (OEM)</string>
    <string name="permissions_autostart_desc">Some manufacturers (e.g., Samsung, Xiaomi, or Oppo) further restrict auto-start and background activity. For Switchly to work reliably, auto-start should be allowed for this app.</string>
    <string name="permissions_btn_request">Request</string>
    <string name="permissions_btn_allow">Allow</string>
