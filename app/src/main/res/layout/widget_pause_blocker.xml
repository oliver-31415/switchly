<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetPauseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@color/widget_scanner_surface"
    android:padding="10dp">

    <TextView
        android:id="@+id/widgetPauseHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text="@string/widget_pause_blocker_name"
        android:textColor="@color/widget_scanner_title"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:drawablePadding="6dp" />

    <TextView
        android:id="@+id/widgetPause15"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@color/widget_scanner_button_surface"
        android:text="@string/widget_pause_15"
        android:textColor="@color/widget_scanner_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widgetPause30"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@color/widget_scanner_button_surface"
        android:text="@string/widget_pause_30"
        android:textColor="@color/widget_scanner_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widgetPause60"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@color/widget_scanner_button_surface"
        android:text="@string/widget_pause_60"
        android:textColor="@color/widget_scanner_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
