<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="4dp"
        android:paddingEnd="18dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dialog_section_details"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTagUid"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:hint="@string/paired_tag_uid_label"
            app:endIconMode="none"
            app:startIconDrawable="@drawable/nfc_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTagUid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:maxLines="1"
                android:inputType="none"
                android:fontFamily="monospace" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTagName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/paired_tag_name_hint"
            app:boxStrokeColor="?attr/colorPrimary"
            app:endIconMode="none"
            app:hintTextColor="?attr/colorPrimary"
            app:startIconDrawable="@drawable/edit_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTagName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:inputType="textCapSentences"
                android:autofillHints="name"
                android:importantForAutofill="yes" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTagNote"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/paired_tag_note_hint"
            app:boxStrokeColor="?attr/colorPrimary"
            app:endIconMode="none"
            app:hintTextColor="?attr/colorPrimary"
            app:startIconDrawable="@drawable/info_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTagNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:inputType="textCapSentences|textMultiLine"
                android:autofillHints="none"
                android:importantForAutofill="yes"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/manage_barcodes_action_section_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTagProfile"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/qr_profile_fallback"
            app:boxStrokeColor="?attr/colorPrimary"
            app:endIconMode="dropdown_menu"
            app:hintTextColor="?attr/colorPrimary"
            app:startIconDrawable="@drawable/account_box_24">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/acTagProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTagAction"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/qr_action"
            app:boxStrokeColor="?attr/colorPrimary"
            app:endIconMode="dropdown_menu"
            app:hintTextColor="?attr/colorPrimary"
            app:startIconDrawable="@drawable/play_arrow_24">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/acTagAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvWrittenActionHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:visibility="gone"
            android:text="@string/paired_tag_use_written_helper"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTagMinutes"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/qr_minutes"
            app:boxStrokeColor="?attr/colorPrimary"
            app:endIconMode="dropdown_menu"
            app:hintTextColor="?attr/colorPrimary"
            app:startIconDrawable="@drawable/schedule_24">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/acTagMinutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRewriteTag"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/paired_tag_rewrite_action"
            android:visibility="gone"
            app:icon="@drawable/nfc_24"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/manage_barcodes_limits_section_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/paired_tag_daily_limit_label"
            app:boxStrokeColor="?attr/colorPrimary"
            app:endIconMode="none"
            app:hintTextColor="?attr/colorPrimary"
            app:startIconDrawable="@drawable/bar_chart_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTagDailyLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/paired_tag_daily_limit_helper"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/paired_tag_cooldown_label"
            app:boxStrokeColor="?attr/colorPrimary"
            app:endIconMode="none"
            app:hintTextColor="?attr/colorPrimary"
            app:startIconDrawable="@drawable/alarm_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTagCooldownMinutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/paired_tag_cooldown_helper"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/rowButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Switchly.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Switchly.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
