<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/switchly_bg"
    tools:ignore="UseCompoundDrawables,Overdraw,TooManyViews">

    <!-- Topbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        android:background="@color/foqos_bg">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Switchly.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@null"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.Switchly.LargeTitle" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="190dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/layoutHomeRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true">

            <!-- Setup/permissions -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSetup"
                style="@style/Switchly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:id="@+id/layoutProtectionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/dashboard_setup_title"
                                android:src="@drawable/security_24"
                                app:tint="?attr/colorOnSurface" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSetupTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_setup_title"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSetupSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:alpha="0.78"
                                android:text="@string/dashboard_setup_subtitle"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSetupDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingStart="10dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp"
                        android:text="@string/dashboard_setup_desc"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFinishSetup"
                        style="@style/Switchly.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/dashboard_setup_cta"
                        app:icon="@drawable/security_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:id="@+id/spaceBeforeStatusCard"
                android:layout_width="1dp"
                android:layout_height="16dp" />

            <!-- Status/primary action -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                style="@style/Switchly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/layoutStatusContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="18dp">

                    <!-- Foqos-style Profiles section -->
                    <LinearLayout
                        android:id="@+id/layoutProfilesHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvProfilesTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/profile_rows_title"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageProfiles"
                            style="@style/Switchly.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_rows_manage" />
                    </LinearLayout>

                    <!-- Foqos hero profile card: active profile summary -->
                    <LinearLayout
                        android:id="@+id/heroProfileRoot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp"
                        android:padding="16dp"
                        android:background="@drawable/hero_profile_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvHeroProfileName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="Work Profile" />

                            <ImageView
                                android:id="@+id/ibtnHeroEdit"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:padding="8dp"
                                android:background="@drawable/bg_round_outline"
                                android:contentDescription="@string/profile_rows_manage"
                                android:src="@drawable/edit_24"
                                app:tint="?attr/colorOnSurface" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHeroChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="12sp"
                            android:alpha="0.85"
                            tools:text="Block selected · Auto-block new apps" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_round_filled">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/security_24"
                                    app:tint="?attr/colorOnPrimary" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvHeroStrategy"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="Manual Blocking" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/hero_stat_apps"
                                    android:textSize="12sp"
                                    android:alpha="0.8" />

                                <TextView
                                    android:id="@+id/tvHeroStatApps"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="9" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/hero_stat_domains"
                                    android:textSize="12sp"
                                    android:alpha="0.8" />

                                <TextView
                                    android:id="@+id/tvHeroStatDomains"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="0" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/hero_stat_blocks"
                                    android:textSize="12sp"
                                    android:alpha="0.8" />

                                <TextView
                                    android:id="@+id/tvHeroStatBlocks"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="11" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/profileRowsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.divider.MaterialDivider
                        style="@style/Switchly.Divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="6dp" />

                    <!-- Hero status (hidden: status lives in the dock launcher) -->
                    <LinearLayout
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivStatusIcon"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:padding="6dp"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/app_blocking_black_24"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSwitchMode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/protection_status_placeholder"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:letterSpacing="-0.01"
                                android:maxLines="2" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Current configuration summary -->
                    <LinearLayout
                        android:id="@+id/rowActiveProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:visibility="gone"
                        android:minHeight="42dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:alpha="0.78"
                            android:contentDescription="@null"
                            android:src="@drawable/account_box_24"
                            app:tint="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvActiveProfile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/dashboard_active_profile_unknown"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:alpha="0.6"
                            android:contentDescription="@string/open"
                            android:src="@drawable/keyboard_arrow_right_24" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvControlModeHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:alpha="0.82"
                        android:text="@string/dashboard_control_mode_hint_placeholder"
                        android:textSize="13sp"
                        android:maxLines="2"
                        android:lineSpacingExtra="1dp"
                        android:drawablePadding="10dp"
                        app:drawableStartCompat="@drawable/tune_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSimplePickApps"
                        style="@style/Switchly.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/pick_apps"
                        app:icon="@drawable/apps_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />

                    <TextView
                        android:id="@+id/tvNfcLockedHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        android:text="@string/dashboard_nfc_locked_hint"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTempHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="9dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:alpha="0.9"
                        android:text="@string/dashboard_temp_hint"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:drawablePadding="10dp"
                        app:drawableEndCompat="@drawable/keyboard_arrow_right_24"
                        app:drawableStartCompat="@drawable/schedule_24" />

                    <TextView
                        android:id="@+id/tvEmergencyHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="9dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:alpha="0.9"
                        android:text="@string/dashboard_emergency_hint_ready"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:drawablePadding="10dp"
                        app:drawableEndCompat="@drawable/keyboard_arrow_right_24"
                        app:drawableStartCompat="@drawable/security_24" />

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/dividerBeforeProfileDropdown"
                        style="@style/Switchly.Divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp" />

                    <!-- Profile dropdown (replaced by profile rows; kept for compat) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutProfileDropdown"
                        style="@style/Switchly.DropdownLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:hint="@string/select_profile"
                        app:endIconMode="dropdown_menu">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/profileDropdown"
                            style="@style/Switchly.DropdownText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@null"
                            android:inputType="none"
                            android:dropDownVerticalOffset="8dp"
                            android:dropDownWidth="match_parent"
                            android:importantForAutofill="no" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Activity heatmap (Foqos BlockedSessionsHabitTracker) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActivity"
                style="@style/Switchly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvActivityTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:text="@string/activity_section_title"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnActivityHide"
                            style="@style/Switchly.OutlinedButton.CompactSegment"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minWidth="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/activity_hide"
                            app:icon="@drawable/visibility_off_24"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:iconSize="14dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvActivityWeek"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="This week: 4h 10m" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChartHeatmap"
                            style="@style/Switchly.OutlinedButton.CompactSegment"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minWidth="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/activity_chart_mode_heatmap"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChartWeek"
                            style="@style/Switchly.OutlinedButton.CompactSegment"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="6dp"
                            android:minWidth="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/activity_chart_mode_week"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeatmapLegend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textSize="12sp"
                        tools:text="legend" />

                    <at.saltyy.switchly.ui.widgets.FoqosHeatmapView
                        android:id="@+id/activityHeatmap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/activity_heatmap_content_desc" />

                    <at.saltyy.switchly.ui.widgets.WeeklyBarChartView
                        android:id="@+id/activityWeekChart"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvActivityDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="20dp"
                        android:alpha="0.8"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include
                layout="@layout/view_home_quick_actions" />

            <!-- Next schedule (optional) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNextSchedule"
                style="@style/Switchly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/schedules_next_title"
                        android:src="@drawable/schedule_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNextScheduleTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/schedules_next_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNextScheduleValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/schedules_next_none"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical"
                        android:alpha="0.72"
                        android:contentDescription="@string/open"
                        android:src="@drawable/keyboard_arrow_right_24"
                        android:scaleType="centerInside" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- App list -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBlockedApps"
                style="@style/Switchly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/rowBlockedAppsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/blockedHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/blocked_list_title"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickApps"
                            style="@style/Switchly.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pick_apps"
                            app:icon="@drawable/apps_24"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp" />

                        <ImageView
                            android:id="@+id/ivBlockedAppsChevron"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:padding="12dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/dashboard_blocked_apps_collapse"
                            android:src="@drawable/keyboard_arrow_up_24"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutBlockedAppsContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.divider.MaterialDivider
                            style="@style/Switchly.Divider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:id="@+id/layoutBlockedAppsEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:ignore="UseCompoundDrawables">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                tools:ignore="UseCompoundDrawables,UselessParent">

                                <ImageView
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:layout_marginStart="-2dp"
                                    android:padding="7dp"
                                    android:alpha="0.75"
                                    android:contentDescription="@string/blocked_list_title"
                                    android:src="@drawable/apps_24"
                                    app:tint="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/tvEmpty"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:alpha="0.85"
                                    android:text="@string/no_blocked_apps"
                                    android:ellipsize="end"
                                    android:singleLine="true" />
                            </LinearLayout>
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvBlocked"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/bottomNavTourDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Bottom dock: Foqos-style launcher (primary action + active timer) -->
    <LinearLayout
        android:id="@+id/layoutBottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutLauncher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggle"
                style="@style/Switchly.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="@string/dashboard_toggle_enable" />

            <TextView
                android:id="@+id/tvActiveDuration"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="visible"
                android:text="@string/dashboard_active_duration_placeholder"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom-Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:background="?attr/colorSurface"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_main" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
