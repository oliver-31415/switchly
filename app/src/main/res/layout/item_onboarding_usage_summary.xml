<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero summary -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summaryHeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/onb_summary_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/onb_summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_quick_summary_title"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textSize="28sp"
                    android:letterSpacing="0.01"
                    android:textColor="@color/onb_summary_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/onb_quick_summary_desc"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textSize="17sp"
                    android:textColor="@color/onb_summary_text_secondary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/onb_summary_stroke" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/usage_total_screen_time"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textSize="18sp"
                    android:textColor="@color/onb_summary_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/totalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/usage_time_zero_long"
                    android:textAppearance="?attr/textAppearanceDisplaySmall"
                    android:textSize="42sp"
                    android:letterSpacing="-0.01"
                    android:textColor="@color/onb_summary_text_primary"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Top apps + donut -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/topAppsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/onb_summary_card_alt"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/onb_summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_top_apps_7d"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textSize="20sp"
                    android:textColor="@color/onb_summary_text_primary"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/donutContainer"
                    android:layout_width="match_parent"
                    android:layout_height="252dp"
                    android:layout_marginTop="8dp">

                    <at.saltyy.switchly.ui.widgets.DonutChartView
                        android:id="@+id/donut"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/top3Total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="#50000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.2"
                        android:text="@string/usage_time_zero_medium"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textSize="24sp"
                        android:includeFontPadding="false"
                        android:textColor="@color/onb_summary_text_primary"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/donut"
                        app:layout_constraintEnd_toEndOf="@id/donut"
                        app:layout_constraintStart_toStartOf="@id/donut"
                        app:layout_constraintTop_toTopOf="@id/donut" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconCard1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/onb_summary_surface"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="4dp"
                        app:cardPreventCornerOverlap="false"
                        app:cardUseCompatPadding="false"
                        app:layout_constraintStart_toStartOf="@id/donut"
                        app:layout_constraintEnd_toEndOf="@id/donut"
                        app:layout_constraintTop_toTopOf="@id/donut"
                        app:layout_constraintBottom_toBottomOf="@id/donut">

                        <ImageView
                            android:id="@+id/icon1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="false"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:padding="6dp"
                            android:scaleType="centerInside" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconCard2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/onb_summary_surface"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="4dp"
                        app:cardPreventCornerOverlap="false"
                        app:cardUseCompatPadding="false"
                        app:layout_constraintStart_toStartOf="@id/donut"
                        app:layout_constraintEnd_toEndOf="@id/donut"
                        app:layout_constraintTop_toTopOf="@id/donut"
                        app:layout_constraintBottom_toBottomOf="@id/donut">

                        <ImageView
                            android:id="@+id/icon2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="false"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:padding="6dp"
                            android:scaleType="centerInside" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconCard3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/onb_summary_surface"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="4dp"
                        app:cardPreventCornerOverlap="false"
                        app:cardUseCompatPadding="false"
                        app:layout_constraintStart_toStartOf="@id/donut"
                        app:layout_constraintEnd_toEndOf="@id/donut"
                        app:layout_constraintTop_toTopOf="@id/donut"
                        app:layout_constraintBottom_toBottomOf="@id/donut">

                        <ImageView
                            android:id="@+id/icon3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="false"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:padding="6dp"
                            android:scaleType="centerInside" />
                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Trend -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/trendCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/onb_summary_card_alt"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/onb_summary_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTrendTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_usage_trend_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textSize="18sp"
                    android:textColor="@color/onb_summary_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTrendApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/common_dash"
                    android:textColor="@color/onb_summary_text_secondary" />

                <at.saltyy.switchly.ui.widgets.WeeklyBarChartView
                    android:id="@+id/weeklyChart"
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrant"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/usage_open_settings"
            android:visibility="gone" />

        <TextView
            android:id="@+id/permHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/usage_access_needed_desc"
            android:textColor="@color/onb_summary_text_secondary"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
