<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="12dp"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <!-- Subtle header spacing (dialog title is set in code) -->
        <Space
            android:layout_width="1dp"
            android:layout_height="4dp" />

        <!-- Profile (Exposed dropdown) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/schedules_field_profile"
            app:boxBackgroundMode="outline"
            app:endIconMode="dropdown_menu"
            app:startIconDrawable="@drawable/account_box_24">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/spinnerProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:inputType="none"
                android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action (Exposed dropdown) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAction"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/schedules_field_action"
            app:boxBackgroundMode="outline"
            app:endIconMode="dropdown_menu"
            app:startIconDrawable="@drawable/play_arrow_24">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/spinnerAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:inputType="none"
                android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textActionNfcHint"
                style="@style/TextAppearance.MaterialComponents.Body2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:text="@string/schedules_dialog_nfc_lock_hint" />
        </LinearLayout>

        <!-- TIME MODE (only shown for time schedules) -->
        <LinearLayout
            android:id="@+id/groupTimeMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutTimeMode"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/schedules_time_mode"
                app:boxBackgroundMode="outline"
                app:endIconMode="dropdown_menu"
                app:startIconDrawable="@drawable/schedule_24">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinnerTimeMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="center_vertical"
                    android:inputType="none"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Title -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/schedules_field_title_hint"
            app:boxBackgroundMode="outline"
            app:endIconMode="none"
            app:hintTextColor="?attr/colorOnSurface"
            app:startIconDrawable="@drawable/edit_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:inputType="textCapSentences"
                android:autofillHints="name" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Note -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/schedules_field_note_hint"
            app:boxBackgroundMode="outline"
            app:endIconMode="none"
            app:hintTextColor="?attr/colorOnSurface"
            app:startIconDrawable="@drawable/info_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:minLines="2"
                android:inputType="textCapSentences|textMultiLine"
                android:autofillHints="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Time group (only for time schedules + not date-range) -->
        <LinearLayout
            android:id="@+id/groupTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Connection schedules (Wi‑Fi/Bluetooth): allow optional time window -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchConnTimeWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                android:text="@string/schedules_conn_time_window" />

            <TextView
                android:id="@+id/textConnAllDayHint"
                style="@style/TextAppearance.MaterialComponents.Body2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone"
                android:text="@string/schedules_conn_time_all_day" />

            <!-- Full-width buttons so they visually match dropdowns/inputs -->
            <LinearLayout
                android:id="@+id/groupTimeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/textStartTime"
                    style="@style/Switchly.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:minWidth="0dp"
                    android:text="@string/schedules_start_time"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:textAllCaps="false"
                    app:icon="@drawable/alarm_24"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/textEndTime"
                    style="@style/Switchly.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="10dp"
                    android:minWidth="0dp"
                    android:text="@string/schedules_end_time"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:textAllCaps="false"
                    app:icon="@drawable/alarm_24"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutWifiSsid"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:hint="@string/schedules_wifi_ssid_hint"
            app:boxBackgroundMode="outline"
            app:endIconMode="none"
            app:startIconDrawable="@drawable/wifi_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputWifiSsid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:inputType="text"
                android:autofillHints="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Wi‑Fi helpers (only visible for Wi‑Fi schedules) -->
        <LinearLayout
            android:id="@+id/groupWifiActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanWifi"
                style="@style/Switchly.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/schedules_wifi_pick_action"
                app:icon="@drawable/wifi_24"
                app:iconGravity="textStart" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutBtName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:hint="@string/schedules_bt_name_hint"
            app:boxBackgroundMode="outline"
            app:endIconMode="none"
            app:startIconDrawable="@drawable/bluetooth_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputBtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:inputType="text"
                android:autofillHints="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/groupBtActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUseConnectedBt"
                style="@style/Switchly.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/schedules_bt_use_connected"
                app:icon="@drawable/bluetooth_24"
                app:iconGravity="textStart" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickPairedBt"
                style="@style/Switchly.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/schedules_bt_pick_paired"
                app:icon="@drawable/bluetooth_24"
                app:iconGravity="textStart" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutLocationLabel"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:hint="@string/schedules_location_label_hint"
            app:boxBackgroundMode="outline"
            app:endIconMode="none"
            app:startIconDrawable="@drawable/location_on_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputLocationLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:inputType="textCapSentences"
                android:autofillHints="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/groupLocationActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutLocationTrigger"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/schedules_location_trigger_title"
                app:boxBackgroundMode="outline"
                app:endIconMode="dropdown_menu"
                app:startIconDrawable="@drawable/location_on_24">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinnerLocationTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="center_vertical"
                    android:inputType="none"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textLocationSummary"
                style="@style/TextAppearance.MaterialComponents.Body2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:text="@string/schedules_location_not_set" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUseCurrentLocation"
                style="@style/Switchly.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/schedules_location_choose"
                app:icon="@drawable/location_on_24"
                app:iconGravity="textStart" />

            <TextView
                style="@style/TextAppearance.MaterialComponents.Subtitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:text="@string/schedules_location_radius_title" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupLocationRadius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRadius100"
                    style="@style/Switchly.DayChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/schedules_location_radius_100"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRadius250"
                    style="@style/Switchly.DayChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/schedules_location_radius_250"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRadius500"
                    style="@style/Switchly.DayChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/schedules_location_radius_500"
                    android:checkable="true" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutLocationCooldown"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/schedules_location_cooldown_title"
                app:boxBackgroundMode="outline"
                app:endIconMode="dropdown_menu"
                app:startIconDrawable="@drawable/alarm_24">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinnerLocationCooldown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="center_vertical"
                    android:inputType="none"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Weekly group -->
        <LinearLayout
            android:id="@+id/groupWeekly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.MaterialComponents.Subtitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/schedules_days" />

            <!-- Keep all days on one line (scroll if needed) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:chipSpacingHorizontal="4dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMon"
                        style="@style/Switchly.DayChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/day_short_mon"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTue"
                        style="@style/Switchly.DayChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/day_short_tue"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWed"
                        style="@style/Switchly.DayChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/day_short_wed"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipThu"
                        style="@style/Switchly.DayChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/day_short_thu"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFri"
                        style="@style/Switchly.DayChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/day_short_fri"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSat"
                        style="@style/Switchly.DayChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/day_short_sat"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSun"
                        style="@style/Switchly.DayChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="@string/day_short_sun"
                        android:checkable="true" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                style="@style/TextAppearance.MaterialComponents.Subtitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:text="@string/schedules_quick_groups" />

            <!-- Quick selections: also single-line + scroll to avoid wrapping -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    app:chipSpacingHorizontal="4dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWeekdays"
                        style="@style/Switchly.DayChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schedules_group_weekdays" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWeekend"
                        style="@style/Switchly.DayChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schedules_group_weekend" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipToday"
                        style="@style/Switchly.DayChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schedules_group_today" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Date-range group (one-time) -->
        <LinearLayout
            android:id="@+id/groupOnce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.MaterialComponents.Subtitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/schedules_date_range" />

            <!-- Full-width buttons so they visually match dropdowns/inputs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/textStartDate"
                    style="@style/Switchly.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:minWidth="0dp"
                    android:text="@string/schedules_start_date"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:textAllCaps="false"
                    app:icon="@drawable/schedule_24"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/textEndDate"
                    style="@style/Switchly.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="10dp"
                    android:minWidth="0dp"
                    android:text="@string/schedules_end_date"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:textAllCaps="false"
                    app:icon="@drawable/schedule_24"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
