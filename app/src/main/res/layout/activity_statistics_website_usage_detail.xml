<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseCompoundDrawables">

    <!-- Topbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Switchly.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/keyboard_arrow_left_24"
            app:title="" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="UseCompoundDrawables">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="top">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/language_24"
                    app:tint="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="YouTube" />

                    <TextView
                        android:id="@+id/detailSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.72"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        tools:text="Usage, limits, and activity" />

                    <TextView
                        android:id="@+id/todayUsage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/usage_today"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/rangeTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/usage_week_total"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <!-- Quick limit editor (time) -->

                <ImageButton
                    android:id="@+id/btnEditLimits"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/edit_limits"
                    app:srcCompat="@drawable/tune_24"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvDailyLimitValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_limit"
                        android:textColor="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageBlocking"
                            style="@style/Switchly.OutlinedButton.CompactSegment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/website_manage_blocking" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvLimitHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.7"
                android:text="@string/limits_quick_edit_hint"
                android:textColor="?attr/colorOnSurface" />

            <!-- Range selector -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRangeToday"
                    style="@style/Switchly.OutlinedButton.CompactSegment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/usage_range_today" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRangeWeek"
                    style="@style/Switchly.OutlinedButton.CompactSegment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/usage_range_week" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRangeMonth"
                    style="@style/Switchly.OutlinedButton.CompactSegment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/usage_range_month" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRangeYear"
                    style="@style/Switchly.OutlinedButton.CompactSegment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/usage_range_year" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRangeCustom"
                    style="@style/Switchly.OutlinedButton.CompactSegment"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:gravity="center"
                    android:contentDescription="@string/activity_history_range_custom"
                    android:text=""
                    app:icon="@drawable/calendar_month_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/customRangeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/customRangeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCustomRange"
                    style="@style/Switchly.OutlinedButton.CompactSegment"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:text="@string/stats_range_clear" />
            </LinearLayout>

            <at.saltyy.switchly.ui.widgets.WeeklyBarChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="16dp" />

            <at.saltyy.switchly.ui.widgets.TimeSeriesLineChartView
                android:id="@+id/lineChart"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/weekdayRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/day1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:alpha="0.7"
                    android:text="@string/day_short_mon"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/day2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:alpha="0.7"
                    android:text="@string/day_short_tue"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/day3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:alpha="0.7"
                    android:text="@string/day_short_wed"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/day4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:alpha="0.7"
                    android:text="@string/day_short_thu"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/day5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:alpha="0.7"
                    android:text="@string/day_short_fri"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/day6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:alpha="0.7"
                    android:text="@string/day_short_sat"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/day7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:alpha="0.7"
                    android:text="@string/day_short_sun"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWebsiteTimeline"
                style="@style/Switchly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:id="@+id/websiteTimelineContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/websiteTimelineTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/website_timeline_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/websiteTimelineEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.75"
                        android:text="@string/website_timeline_empty"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
