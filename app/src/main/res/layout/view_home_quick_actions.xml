<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardQuickActions"
    style="@style/Switchly.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:id="@+id/rowQuickActionsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp">
            <TextView
                android:id="@+id/tvQuickActionsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="true"
                android:text="@string/dashboard_quick_actions"
                android:textStyle="bold"
                android:textSize="14sp"
                android:alpha="0.75" />
            <ImageView
                android:id="@+id/ivQuickActionsEdit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dashboard_quick_actions_edit"
                android:padding="12dp"
                android:src="@drawable/edit_24"
                app:tint="?attr/colorOnSurface" />
            <ImageView
                android:id="@+id/ivQuickActionsChevron"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dashboard_quick_actions_collapse"
                android:padding="12dp"
                android:src="@drawable/keyboard_arrow_up_24"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>
        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/dividerQuickActions"
            style="@style/Switchly.Divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="2dp" />
        <!-- Quick actions tiles -->
        <LinearLayout
            android:id="@+id/gridQuickActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/rowManageShortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileManageApps"
                    style="@style/Switchly.TileCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="116dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:padding="8dp"
                            android:src="@drawable/apps_24"
                            app:tint="?attr/colorOnSurface"
                            android:contentDescription="@string/dashboard_tile_apps" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_apps"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:alpha="0.95" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_apps_sub"
                            android:textSize="12sp"
                            android:alpha="0.75" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileProfiles"
                    style="@style/Switchly.TileCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="116dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:padding="8dp"
                            android:src="@drawable/switch_account_24"
                            app:tint="?attr/colorOnSurface"
                            android:contentDescription="@string/dashboard_tile_profiles" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_profiles"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:alpha="0.95" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_profiles_sub"
                            android:textSize="12sp"
                            android:alpha="0.75" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileWriteNfc"
                    style="@style/Switchly.TileCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="116dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:padding="8dp"
                            android:src="@drawable/language_24"
                            app:tint="?attr/colorOnSurface"
                            android:contentDescription="@string/dashboard_tile_blocked_websites" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_blocked_websites"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:alpha="0.95" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_blocked_websites_sub"
                            android:textSize="12sp"
                            android:alpha="0.75" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowUtilityShortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileToggleOptions"
                    style="@style/Switchly.TileCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="116dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:padding="8dp"
                            android:src="@drawable/apps_24"
                            app:tint="?attr/colorOnSurface"
                            android:contentDescription="@string/dashboard_tile_in_app" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_in_app"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:alpha="0.95" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_in_app_sub"
                            android:textSize="12sp"
                            android:alpha="0.75" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <!-- QR/Barcode quick actions -->
            <LinearLayout
                android:id="@+id/rowScanShortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:visibility="gone">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileQr"
                    style="@style/Switchly.TileCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="116dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:padding="8dp"
                            android:src="@drawable/qr_code_24"
                            app:tint="?attr/colorOnSurface"
                            android:contentDescription="@string/dashboard_tile_qr" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_qr"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:alpha="0.95" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_qr_sub"
                            android:textSize="12sp"
                            android:alpha="0.75" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileBarcode"
                    style="@style/Switchly.TileCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="116dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:padding="8dp"
                            android:src="@drawable/barcode_24"
                            app:tint="?attr/colorOnSurface"
                            android:contentDescription="@string/dashboard_tile_barcode" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_barcode"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:alpha="0.95" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_barcode_sub"
                            android:textSize="12sp"
                            android:alpha="0.75" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowToolsShortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:visibility="gone">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileNfcWrite"
                    style="@style/Switchly.TileCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="116dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:padding="8dp"
                            android:src="@drawable/nfc_24"
                            app:tint="?attr/colorOnSurface"
                            android:contentDescription="@string/dashboard_tile_write_nfc" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_write_nfc"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:alpha="0.95" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_write_nfc_sub"
                            android:textSize="12sp"
                            android:alpha="0.75" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileBlockedNotifications"
                    style="@style/Switchly.TileCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="116dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:padding="8dp"
                            android:src="@drawable/notifications_24"
                            app:tint="?attr/colorOnSurface"
                            android:contentDescription="@string/dashboard_tile_blocked_notifications" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_blocked_notifications"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:alpha="0.95" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/dashboard_tile_blocked_notifications_sub"
                            android:textSize="12sp"
                            android:alpha="0.75" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
