<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Topbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Switchly.TopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:title="@string/write_nfc_tag"
            app:navigationIcon="@drawable/arrow_back_ios_24" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/nfc_profile_hint"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/ddProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:importantForAutofill="no"
                    android:hint="@null"
                    android:dropDownWidth="match_parent"
                    android:dropDownVerticalOffset="8dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Action -->
            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/nfc_action_hint"
                    android:orientation="vertical"
                    app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/ddAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dropDownWidth="match_parent"
                    android:dropDownVerticalOffset="8dp"
                    android:hint="@null"
                    android:importantForAutofill="no"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Temp disable duration (only visible when action = temp) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/nfc_duration_hint"
                android:visibility="gone"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/ddTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:importantForAutofill="no"
                    android:hint="@null"
                    android:dropDownWidth="match_parent"
                    android:dropDownVerticalOffset="8dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvTempHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nfc_temp_hint_timer_behavior"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Start/Cancel button -->
            <Button
                android:id="@+id/btnArmWrite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/nfc_arm_write" />

            <!-- Status -->
            <LinearLayout
                android:id="@+id/statusRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:background="@color/status_surface"
                android:visibility="gone"
                android:animateLayoutChanges="true">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nfc_waiting_tag"
                    android:textColor="@color/status_neutral" />

                <ProgressBar
                    android:id="@+id/statusProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
