<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/colorPickerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/colorPickerHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pref_accent_custom_title"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <View
        android:id="@+id/colorPreview"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#2E8B57"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/color_channel_r" />

    <SeekBar
        android:id="@+id/sliderR"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/color_channel_g"
        android:layout_marginTop="8dp" />

    <SeekBar
        android:id="@+id/sliderG"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/color_channel_b"
        android:layout_marginTop="8dp" />

    <SeekBar
        android:id="@+id/sliderB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
