<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="UseCompoundDrawables">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Topbar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Switchly.TopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                app:title="@string/in_app_blocking_title"
                app:navigationIcon="@drawable/arrow_back_ios_24" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- In-app rule mode -->
        <TextView
            android:id="@+id/tvInAppRuleModeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:text="@string/in_app_rule_mode_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleInAppRuleMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInAppModeBlock"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/in_app_rule_mode_block" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInAppModeAllow"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/in_app_rule_mode_allow" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvInAppRuleModeSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="@string/in_app_rule_mode_block_summary"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <!-- In-app limit (timed rules disabled for now) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInAppLimit"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/in_app_blocking_limit_title"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/in_app_blocking_limit_desc"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_limit_label"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.85" />

                    <TextView
                        android:id="@+id/tvInAppLimitValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/no_limit"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <Button
                        android:id="@+id/btnInAppLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/set_daily_limit" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInAppEmpty"
            style="@style/Switchly.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/in_app_rules_empty_installed"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.72"
                    android:text="@string/in_app_rules_empty_installed_summary"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- YouTube -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardYouTube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:ignore="UseCompoundDrawables">

                <LinearLayout
                    android:id="@+id/headerYouTube"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/in_app_blocking_youtube"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:id="@+id/arrowYouTube"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/arrow_drop_down_24"
                        app:tint="?attr/colorOnSurface"
                        android:alpha="0.8"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentYouTube"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swYtShorts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_shorts" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swYtSubscriptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_subscriptions" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swYtYou"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_you" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swYtMiniPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_mini_player" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swYtPip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_pip" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Instagram -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInstagram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:ignore="UseCompoundDrawables">

                <LinearLayout
                    android:id="@+id/headerInstagram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/in_app_blocking_instagram"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:id="@+id/arrowInstagram"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/arrow_drop_down_24"
                        app:tint="?attr/colorOnSurface"
                        android:alpha="0.8"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentInstagram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swIgReels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_reels" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swIgExplore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_explore" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swIgSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="@string/in_app_blocking_block_search" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swIgComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_comments" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swIgStories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_stories" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- X/Twitter -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:ignore="UseCompoundDrawables">

                <LinearLayout
                    android:id="@+id/headerX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/in_app_blocking_x"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:id="@+id/arrowX"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/arrow_drop_down_24"
                        app:tint="?attr/colorOnSurface"
                        android:alpha="0.8"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swXForYou"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_home" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swXSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_search" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swXGrok"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_grok" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swXNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_notifications" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Snapchat -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSnapchat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:ignore="UseCompoundDrawables">

                <LinearLayout
                    android:id="@+id/headerSnapchat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/in_app_blocking_snapchat"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:id="@+id/arrowSnapchat"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/arrow_drop_down_24"
                        app:tint="?attr/colorOnSurface"
                        android:alpha="0.8"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentSnapchat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swSnapMap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_map" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swSnapStories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_stories" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swSnapSpotlight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_spotlight" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swSnapFollowing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/in_app_blocking_block_following" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
