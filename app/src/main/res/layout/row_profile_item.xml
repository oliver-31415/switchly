<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProfile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <View
            android:id="@+id/viewActiveBar"
            android:layout_width="4dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/colorPrimary"
            android:visibility="gone" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/switch_account_24"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="@string/edit" />

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                style="@style/TextAppearance.MaterialComponents.Body1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_label_default"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/TextAppearance.MaterialComponents.Body2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/profile_row_subtitle"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.7" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/state_profile_on_status"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface"
            android:background="?attr/colorPrimary"
            android:visibility="gone" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/edit_24"
            app:tint="?android:attr/textColorSecondary"
            android:contentDescription="@string/edit" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
