<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_section_filter"
            android:textStyle="bold"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbFilterAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_filter_all_apps" />

            <RadioButton
                android:id="@+id/rbFilterBlocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_filter_blocked_only" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_section_sort"
            android:textStyle="bold"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgSort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbSortPrimaryDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_sort_used_time_desc" />

            <RadioButton
                android:id="@+id/rbSortPrimaryAsc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_sort_used_time_asc" />

            <RadioButton
                android:id="@+id/rbSortAz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_sort_az" />

            <RadioButton
                android:id="@+id/rbSortZa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_sort_za" />
        </RadioGroup>

    </LinearLayout>
</ScrollView>
