    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- FOCUS & BLOCKING -->
    <PreferenceScreen
        android:key="screen_focus_blocking"
        android:order="10"
        android:layout="@layout/pref_card_item"
        android:title="@string/settings_focus_blocking_title"
        android:summary="@string/settings_focus_blocking_summary"
        android:icon="@drawable/apps_24"
        app:iconSpaceReserved="false">

        <Preference
            android:key="pref_toggle_options_blocking"
            android:layout="@layout/pref_card_item"
            android:title="@string/toggle_options_blocking_title"
            android:summary="@string/toggle_options_blocking_summary"
            android:icon="@drawable/tune_24"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="pref_in_app_blocking"
            android:layout="@layout/pref_card_item"
            android:title="@string/in_app_blocking_title"
