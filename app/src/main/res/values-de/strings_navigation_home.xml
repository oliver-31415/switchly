    <string name="app_picker_protected_generic_hint">Diese App ist aus Gerätesicherheitsgründen geschützt.</string>
    <string name="app_picker_protected_keyboard_hint">Deine aktuelle Tastatur wird vom Blockieren ausgeschlossen, damit du dich nicht vom Tippen aussperrst.</string>
    <string name="app_picker_protected_launcher_hint">Dein aktueller Launcher wird vom Blockieren ausgeschlossen, damit du dich nicht vom Homescreen aussperrst.</string>
    <string name="app_picker_wallet_hint">Wallet-Apps können auf manchen Geräten Gesten oder Schnellzugriffe stören.</string>
