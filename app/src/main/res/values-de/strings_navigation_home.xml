    <string name="app_picker_wallet_warning_title">Diese Wallet-App trotzdem blockieren?</string>
    <string name="app_picker_wallet_warning_message">Wallet-Apps können auf manchen Geräten Gesten oder Schnellzugriffe stören. Blockiere diese App nur, wenn du sicher bist, dass dein Handy danach normal nutzbar bleibt.</string>
    <string name="app_picker_wallet_warning_message_samsung">Samsung Wallet kann auf Galaxy-Geräten über die Quick-Access-Geste vom unteren Bildschirmrand geöffnet werden. Das Blockieren kann die normale Nutzung des Homescreens stören. Blockiere sie nur, wenn du dieses Verhalten wirklich willst.</string>
    <string name="app_picker_dialer_warning_title">Diese Telefon-App trotzdem blockieren?</string>
    <string name="app_picker_dialer_warning_message">Wenn du deine aktuelle Telefon-App blockierst, können normale Anrufe und der Notfallzugriff schwieriger werden.</string>
    <string name="app_picker_settings_hint">Das Blockieren von Einstellungen kann Fehlerbehebung und Berechtigungsänderungen erschweren.</string>
    <string name="app_picker_settings_warning_title">Einstellungen trotzdem blockieren?</string>
    <string name="app_picker_settings_warning_message">Das Blockieren von Einstellungen kann Fehlerbehebung und Berechtigungsänderungen erschweren.</string>
    <string name="app_picker_play_store_hint">Der Play Store ist sicherheitsrelevant, da er Apps installieren oder aktualisieren kann.</string>
    <string name="app_picker_play_store_warning_title">Play Store trotzdem blockieren?</string>
    <string name="app_picker_play_store_warning_message">Das Blockieren des Play Store kann Installationen, Updates und Wiederherstellung erschweren.</string>
    <string name="app_picker_installer_hint">Der Paket-Installer ist sicherheitsrelevant, da er Apps installieren oder aktualisieren kann.</string>
    <string name="app_picker_installer_warning_title">Paket-Installer trotzdem blockieren?</string>
    <string name="app_picker_installer_warning_message">Das Blockieren des Paket-Installers kann Installationen, Updates und Wiederherstellung erschweren.</string>
    <string name="app_picker_permissions_hint">Der Berechtigungs-Controller ist sicherheitsrelevant, da er wichtige Android-Berechtigungen verwaltet.</string>
    <string name="app_picker_permissions_warning_title">Berechtigungs-Controller trotzdem blockieren?</string>
    <string name="app_picker_permissions_warning_message">Das Blockieren des Berechtigungs-Controllers kann Berechtigungen und Fehlerbehebung erschweren.</string>
    <string name="app_picker_files_hint">Dateien- und Dokumentauswahl-Apps können für Backups, Wiederherstellungen, Exporte und Recovery wichtig sein.</string>
    <string name="app_picker_files_warning_title">Dateien-App trotzdem blockieren?</string>
