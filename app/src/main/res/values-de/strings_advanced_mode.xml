    <!-- Developer mode -->
    <!-- ====================================================== -->
    <string name="developer_mode_title">Developer</string>
    <string name="developer_mode_info_title">Developer-Tools</string>
    <string name="developer_mode_info_body">Developer-Tools sind in normalen Einstellungen versteckt. Du kannst sie hier wieder ausschalten oder später durch langes Drücken auf die Versions-Zeile erneut freischalten.</string>
    <string name="developer_mode_unlocked_toast">Developer-Modus freigeschaltet</string>
    <string name="developer_mode_settings_summary">Öffnet ADB- und Logging-Tools, solange der Developer-Modus aktiviert ist.</string>
    <string name="developer_mode_tile_adb">ADB</string>
    <string name="developer_mode_tile_adb_body">ADB-Befehle für Device Admin, Profile Owner und Device Owner Tests.</string>
    <string name="developer_mode_tile_logging">Logging</string>
    <string name="developer_mode_tile_logging_body">Zeigt die letzten 250 internen App-Log-Zeilen live an und erlaubt das Kopieren zur Fehlersuche.</string>
    <string name="developer_mode_tile_disable">Ausschalten</string>
    <string name="developer_mode_disable_body">Blendet Developer-Tools wieder aus. Später per langem Drücken auf die Versions-Zeile erneut freischalten.</string>
    <string name="developer_mode_disabled_toast">Developer-Modus ausgeschaltet</string>

