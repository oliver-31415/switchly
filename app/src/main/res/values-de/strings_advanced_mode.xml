    <!-- Advanced mode overview -->
    <!-- ====================================================== -->
    <string name="advanced_mode_title">ADB-Tools</string>
    <string name="advanced_mode_admin_label">Switchly</string>
    <string name="advanced_mode_admin_description">Gibt Switchly die nötige Kontrolle für optionale erweiterte Geräteadmin- und Managed-Device-Funktionen.</string>
    <string name="advanced_mode_disable_warning">Wenn du den Switchly-Geräteadmin deaktivierst, werden die erweiterten Managed-Device-Hooks entfernt. Auf normalen persönlichen Geräten ist das nur eine erweiterte Hilfe und keine echte Deinstallationssperre.</string>
    <string name="advanced_mode_summary_body">Erweiterte ADB-Einrichtung für Device Admin, Profile Owner und Device Owner Tests.</string>
    <string name="advanced_mode_recommendation_body">Für die meisten Nutzer ist normale Deinstallations-Reibung richtig. Nutze ADB-Tools nur, wenn du die Voraussetzungen kennst.</string>
    <string name="advanced_mode_constraints_body">Device Owner braucht meist ein frisch eingerichtetes Gerät. Profile Owner hat eigene Grenzen. Device Admin ist eingeschränkt.</string>

