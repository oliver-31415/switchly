         ========================================================= -->
    <string name="permissions_accessibility_title">Bedienungshilfe-Dienst</string>
    <string name="permissions_accessibility_desc">Erforderlich für zuverlässige Blockierung: damit Switchly geöffnete Apps sofort erkennen und deine Profile durchsetzen kann.</string>

    <string name="permissions_usage_access_title">App-Nutzungszugriff</string>
    <string name="permissions_usage_access_desc">Erforderlich für Bildschirmzeit-Statistiken und tägliche App-Limits. Aktiviere den Zugriff auf „App-Nutzungsdaten“ für Switchly.</string>

    <!-- =========================================================
         PERMISSIONS: Card titles + descriptions (Triggers & battery)
         ========================================================= -->
    <string name="permissions_battery_title">Akku-Optimierung</string>
    <string name="permissions_battery_desc">Deaktiviere die Akku-Optimierung, damit Zeitpläne und Empfänger im Hintergrund zuverlässig laufen können.</string>

    <string name="permissions_location_title">Standort</string>
    <string name="permissions_location_desc">Erforderlich, damit WLAN-basierte Zeitpläne das verbundene Netzwerk erkennen können. Für beste Zuverlässigkeit setze den Standortzugriff auf „Immer erlauben“.</string>

    <string name="permissions_bluetooth_title">Bluetooth (Geräte in der Nähe)</string>
    <string name="permissions_bluetooth_desc">Erforderlich für Bluetooth-basierte Zeitpläne (Android 12+).</string>

    <!-- =========================================================
         PERMISSIONS: Card titles + descriptions (Notifications)
         ========================================================= -->
    <string name="permissions_notifications_title">Benachrichtigungen</string>
    <string name="permissions_notifications_desc">Erforderlich, damit Switchly Statusmeldungen und Erinnerungen in den Benachrichtigungen anzeigen kann.</string>

    <string name="permissions_notification_access_title">Benachrichtigungszugriff</string>
    <string name="permissions_notification_access_desc">Erforderlich, um Benachrichtigungen von Apps auszublenden, die durch dein aktives Profil blockiert sind (Benachrichtigungs-Listener-Zugriff).</string>

    <!-- =========================================================
         PERMISSIONS: Card titles + descriptions (OEM)
         ========================================================= -->
    <string name="permissions_autostart_title">Autostart (OEM)</string>
    <string name="permissions_autostart_desc">Einige Hersteller (z. B. Samsung, Xiaomi oder Oppo) schränken Autostart und Hintergrundaktivität zusätzlich ein. Damit Switchly zuverlässig funktioniert, sollte Autostart für diese App erlaubt sein.</string>

