    <string name="block_websites">Websites blockieren</string>
    <string name="block_websites_desc">Blockiere bestimmte Domains in unterstützten Browsern.\nDu kannst auch ein tägliches Zeitlimit festlegen.</string>
    <string name="blocked_websites_title">Blockierte Websites</string>
