    <!-- ADVANCED MODE -->
    <string name="advanced_mode_title">Erweiterte Tools</string>
    <string name="advanced_mode_unlocked_toast">Erweiterte Tools freigeschaltet</string>
    <string name="advanced_mode_admin_label">Switchly</string>
    <string name="advanced_mode_admin_description">Gibt Switchly die nötige Kontrolle für optionale erweiterte Geräteadmin- und Managed-Device-Funktionen.</string>
    <string name="advanced_mode_disable_warning">Wenn du den Switchly-Geräteadmin deaktivierst, werden die erweiterten Managed-Device-Hooks entfernt. Auf normalen persönlichen Geräten ist das nur eine erweiterte Hilfe und keine echte Deinstallationssperre.</string>
    <string name="advanced_mode_tile_status">Aktuelles Managed-Device-Setup</string>
    <string name="advanced_mode_tile_summary">Wofür dieser Modus gedacht ist</string>
    <string name="advanced_mode_tile_recommendation">Für die meisten Nutzer empfohlen</string>
    <string name="advanced_mode_tile_receiver">Admin-Receiver-Komponente</string>
    <string name="advanced_mode_tile_device_owner">ADB: Device Owner setzen</string>
    <string name="advanced_mode_tile_profile_owner">ADB: Profile Owner setzen</string>
    <string name="advanced_mode_tile_remove_admin">ADB: Aktiven Admin entfernen</string>
    <string name="advanced_mode_tile_check_state">ADB: Policy-Status prüfen</string>
    <string name="advanced_mode_tile_constraints">Wichtige Hinweise vorher</string>
    <string name="advanced_mode_tile_docs">Offizielle Doku und Referenz</string>
    <string name="advanced_mode_status_standard">Normaler persönlicher App-Modus.\nKeine Managed-Device-Eigentümerschaft ist aktiv.</string>
    <string name="advanced_mode_status_device_admin">Die alte Geräteadmin-Aktivierung ist aktiv.</string>
    <string name="advanced_mode_status_profile_owner">Profile Owner ist aktiv.</string>
    <string name="advanced_mode_status_device_owner">Device Owner ist aktiv.</string>
    <string name="advanced_mode_summary_body">Dieser Screen ist für fortgeschrittene Nutzer gedacht, die mit Android-Enterprise-ähnlicher Verwaltung per ADB experimentieren möchten.\nAuf normalen persönlichen Geräten kann Switchly nur Deinstallations-Reibung hinzufügen.\nEine stärkere Deinstallationssperre erfordert Managed-Device-Eigentümerschaft und ist kein normaler Consumer-Setup.</string>
    <string name="advanced_mode_recommendation_body">Für fast alle Nutzer ist Switchlys Deinstallations-Reibung die richtige Option.\nNutze diesen Screen nur, wenn du Device-Admin-, Profile-Owner- oder Device-Owner-Flows gezielt testen willst.</string>
    <string name="advanced_mode_constraints_body">Device-Owner-Befehle funktionieren meist nur auf einem frisch eingerichteten Gerät ohne bestehende Konten.\nProfile-Owner-Befehle haben eigene Bereitstellungsgrenzen.\nDevice Admin ist veraltet und entspricht nicht voller Managed-Device-Eigentümerschaft.\nNutze das nur, wenn du weißt, was du tust.</string>
    <string name="advanced_mode_add_admin_explanation">Das aktiviert nur Switchlys optionalen erweiterten Admin-Receiver.\nAuf einem normalen persönlichen Gerät garantiert das keine Deinstallationssperre.</string>
    <string name="advanced_mode_open_admin_failed">Android-Geräteadmin-Bildschirm konnte nicht geöffnet werden</string>
    <string name="advanced_mode_command_copied">Befehl kopiert</string>
    <string name="advanced_mode_docs_body">Öffnet die offizielle Android-Referenz zu DevicePolicyManager.</string>
    <string name="advanced_mode_component_copied">Komponente kopiert</string>
    <string name="advanced_mode_tile_disable_mode">Erweiterten Modus ausschalten</string>
    <string name="advanced_mode_disable_mode_body">Blendet den zusätzlichen erweiterten Eintrag wieder aus.\nDu kannst später jederzeit durch langes Drücken auf die Versions-Zeile zurückkommen.</string>
