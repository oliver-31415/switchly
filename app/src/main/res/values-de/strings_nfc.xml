    <string name="nfc_action_desc_enable">Schreibt ein Tag, das Switchly aktiviert.</string>
    <string name="nfc_action_desc_disable">Schreibt ein Tag, das Switchly deaktiviert.</string>
    <string name="nfc_action_desc_toggle">Schreibt ein Tag, das Switchly EIN/AUS umschaltet.</string>
    <plurals name="nfc_action_desc_temp_disable">
        <item quantity="one">Schreibt ein Tag, das Switchly für %1$d Minute deaktiviert und danach den vorherigen Zustand wiederherstellt.</item>
        <item quantity="other">Schreibt ein Tag, das Switchly für %1$d Minuten deaktiviert und danach den vorherigen Zustand wiederherstellt.</item>
    </plurals>
    <plurals name="nfc_action_desc_temp_enable">
        <item quantity="one">Schreibt ein Tag, das Switchly für %1$d Minute aktiviert und danach den vorherigen Zustand wiederherstellt.</item>
        <item quantity="other">Schreibt ein Tag, das Switchly für %1$d Minuten aktiviert und danach den vorherigen Zustand wiederherstellt.</item>
    </plurals>
    <string name="nfc_action_desc_temp_disable_ask">Kann auch einen universellen Tag schreiben, der beim Scannen nach der Dauer der temporären Pause fragt.</string>
    <string name="nfc_action_desc_temp_enable_ask">Kann auch einen universellen Tag schreiben, der beim Scannen nach der temporären Blockierdauer fragt.</string>
    <string name="nfc_action_desc_pair_uid">Erweitert: Dieses Tag nur per UID koppeln, ohne etwas darauf zu schreiben. Nutze das für schreibgeschützte Tags oder Limits pro Tag, nicht für normale beschreibbare Umschalten-/Deaktivieren-Tags.</string>
    <string name="nfc_action_desc_pair_uid_disabled">„Tag koppeln“ ist deaktiviert. Aktiviere es in Einstellungen → Blocking &amp; Control Toggles → Gepaarte NFC-Tags aktivieren und scanne dann ein Tag, um seine UID zu speichern.</string>
    <string name="nfc_action_desc_profile_selected">Ausgewähltes Profil: %1$s</string>
    <string name="nfc_action_desc_profile_none">Profil: Universell (globale Aktion)</string>
    <string name="nfc_action_emergency_tag_removed">Emergency-Disable per NFC-Tag wird nicht mehr unterstützt. Bitte nutze die Notfall-Entsperrung direkt in der App.</string>
    <string name="nfc_action_error_fmt">Aktion fehlgeschlagen: %1$s</string>

