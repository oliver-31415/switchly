    <string name="nfc_writer_title">NFC-Tag-Writer</string>
    <string name="nfc_write_intro_title">NFC-Aktionstags schreiben</string>
    <string name="nfc_write_onboarding_message">Wähle Umschalten, Aktivieren, Deaktivieren oder eine temporäre Aktion und schreibe sie auf ein beschreibbares NFC-Tag. Scanne das Tag danach einmal bei entsperrtem Handy. Falls Android fragt, welche App geöffnet werden soll, wähle Switchly und Immer. UID-Kopplung ist nur für schreibgeschützte Tags oder Limits pro Tag gedacht und schreibt keine Aktion auf das Tag.</string>
    <string name="nfc_profile_hint">Profil</string>
    <string name="nfc_profile_none">Universell</string>
    <string name="nfc_duration_hint">Temporäre Dauer</string>
    <string name="nfc_temp_hint_timer_behavior">Der temporäre Modus läuft für die gewählte Zeit und stellt danach automatisch den vorherigen Zustand wieder her.</string>
    <string name="nfc_ready_to_write">Bereit zum Schreiben</string>
    <string name="nfc_hold_still">Handy ruhig halten…</string>
    <string name="nfc_close">Schließen</string>
    <string name="nfc_arm_write">Ausgewählte Aktion schreiben</string>
    <string name="nfc_waiting_tag">Halte das Tag an das Smartphone…</string>
    <string name="nfc_writing">Tag wird geschrieben…</string>
    <string name="nfc_write_ok">Tag erfolgreich geschrieben!</string>
    <string name="nfc_write_error_generic">Auf NFC-Tag konnte nicht geschrieben werden.</string>
    <string name="nfc_write_error_too_small">Das NFC-Tag ist für diese Aktion zu klein. Nutze ein Tag mit mehr Speicher.</string>
    <string name="nfc_write_locked_while_enabled">NFC-Tag-Schreiben ist gesperrt, solange Switchly aktiv ist.</string>
    <string name="nfc_write_locked_status">Deaktiviere Switchly, um ein neues NFC-Tag zu schreiben oder zu koppeln, oder erlaube NFC-Tag-Schreiben im Mixed-Mode.</string>
    <string name="nfc_write_locked_button">NFC-Tag-Schreiben gesperrt</string>
    <string name="nfc_not_available">NFC ist auf diesem Gerät nicht verfügbar</string>
