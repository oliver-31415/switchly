            android:parentActivityName=".feature.settings.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".feature.settings.SettingsActivity" />
        </activity>

        <!-- Insights hub for Usage statistics and Active time -->
        <activity
            android:name=".feature.tools.ManageInsightsActivity"
            android:exported="false" />

        <!-- Active time statistics dashboard -->
        <activity
            android:name=".feature.usage.ActiveTimeStatsActivity"
            android:exported="false" />

        <!-- Active time detail screen for sessions and monthly totals -->
        <activity
            android:name=".feature.usage.ActiveTimeDetailActivity"
            android:exported="false" />

        <!-- Usage statistics dashboard -->
        <activity
            android:name=".feature.usage.ScreenTimeDashboardActivity"
            android:exported="false" />

