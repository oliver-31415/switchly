<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking (Firebase Authentication + Cloud Sync) -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Usage Access (Screen time stats) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    
    <!-- Allows checking whether the device is online/offline (used by Firebase + sync logic) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wifi Access -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Android 13+ (Wi-Fi device scanning) -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- Bluetooth -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12+ -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />

    <!-- Location needed to read Wi-Fi SSID for Wi-Fi schedules -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Exact alarm on Android 12+ (user toggle exists) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Background location improves Wi‑Fi trigger reliability when the app is not in the foreground.
         We request it in a 2‑step flow: first "While using the app", then guide the user to "Allow all the time". -->
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:targetApi="29" />

    <!-- Autostart on device reboot (restart blocking service) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- NFC requirements (unlock via NFC tag, tag writing) -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Battery optimization exemption request (shows a system popup on supported devices) -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Foreground services -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 14+ for foregroundServiceType="connectedDevice" -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />

    <!-- Allows killing background processes -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Allows Camera for QR Code -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Camera hardware is optional (ChromeOS/devices without camera) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- NFC hardware is optional -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- Needed so we can list launchable apps in the picker -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".app.App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Switchly"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:replace="android:allowBackup">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <receiver
            android:name=".receiver.DPMReceiver"
            android:exported="true"
            android:label="@string/advanced_mode_admin_label"
            android:description="@string/advanced_mode_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/switchly_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Main launcher -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.entry.ScanLauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="at.saltyy.switchly.action.OPEN_QR_SCAN" />
                <action android:name="at.saltyy.switchly.action.OPEN_BARCODE_SCAN" />
                <action android:name="at.saltyy.switchly.action.OPEN_NFC_WRITE" />
                <action android:name="at.saltyy.switchly.action.OPEN_BLOCKED_NOTIFICATIONS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Play Billing (manifest-merged from the billing library).
            Prevent external/accidental launches of ProxyBillingActivity without required extras, which can crash with a null PendingIntent on some devices/OS versions.
        -->
        <activity
            android:name="com.android.billingclient.api.ProxyBillingActivity"
            android:exported="false"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTask" />

        <!-- Settings -->
        <activity
            android:name=".feature.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings" />

        <!-- Blocking hub -->
        <activity
            android:name=".feature.tools.BlockingHubActivity"
            android:exported="false"
            android:label="@string/nav_blocking" />

        <!-- Manage hub -->
        <activity
            android:name=".feature.tools.ToolsHubActivity"
            android:exported="false"
            android:label="@string/nav_tools" />

        <!-- Schedules screen -->
        <activity
            android:name=".feature.schedule.SchedulesActivity"
            android:exported="false"
            android:label="@string/schedules_title"
            android:parentActivityName=".feature.settings.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".feature.settings.SettingsActivity" />
        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".feature.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.Switchly" />

        <!-- Profiles -->
        <activity
            android:name=".feature.profiles.ManageProfilesActivity"
            android:exported="false" />

        <!-- App picker -->
        <activity
            android:name=".feature.picker.AppPickerActivity"
            android:exported="false" />

        <!-- NFC writer -->
        <activity
            android:name=".feature.tools.ManageKeysActivity"
            android:exported="false" />

        <activity
            android:name=".nfc.NfcWriterActivity"
            android:exported="false"
            android:theme="@style/Theme.Switchly" />

        <activity
            android:name=".nfc.NfcWriteWaitingActivity"
            android:exported="false"
            android:theme="@style/Theme.Switchly" />

        <!-- NFC NDEF dispatch -->
        <activity
            android:name=".nfc.NfcEntryActivity"
            android:exported="true"
            android:launchMode="singleTop">

            <!-- NFC NDEF discovered pointing to switchly://... -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="switchly" android:host="switch" android:pathPattern=".*" />
                <data android:scheme="switchly" android:host="profile" android:pathPattern=".*" />
            </intent-filter>

            <!-- Tech-discovered fallback for cards/tags that are claimed earlier than TAG_DISCOVERED for example IsoDep bank cards and some external/read-only tags). -->
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />

            <!-- Fallback for blank/non-NDEF tags so Switchly can still react. -->
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Blocker -->
        <activity
            android:name=".feature.blocker.BlockerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:theme="@style/Theme.Switchly.Blocker" />

        <!-- About / advanced -->
        <activity
            android:name=".feature.about.AdvancedModeActivity"
            android:exported="false"
            android:label="@string/advanced_mode_title" />

        <!-- FAQ -->
        <activity
            android:name=".feature.faq.FaqActivity"
            android:exported="false"
            android:label="@string/faq_screen_title" />

        <!-- Premium -->
        <activity
            android:name=".feature.premium.PremiumInfoActivity"
            android:exported="false"
            android:label="@string/premium_title" />

        <!-- Permissions screen -->
        <activity
            android:name=".feature.settings.PermissionsActivity"
            android:exported="false"
            android:parentActivityName=".feature.settings.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".feature.settings.SettingsActivity" />
        </activity>

        <!-- Toggle screen -->
        <activity
            android:name=".feature.settings.ToggleOptionsActivity"
            android:exported="false" />

        <!-- Troubleshooting -->
        <activity
            android:name=".feature.settings.TroubleshootingActivity"
            android:exported="false"
            android:label="@string/troubleshooting_title"
            android:parentActivityName=".feature.settings.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".feature.settings.SettingsActivity" />
        </activity>

        <activity
            android:name=".feature.settings.BlockingModesActivity"
            android:exported="false"
            android:parentActivityName=".feature.settings.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".feature.settings.SettingsActivity" />
        </activity>

        <activity
            android:name=".feature.settings.BlockingFeaturesActivity"
            android:exported="false"
            android:parentActivityName=".feature.settings.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".feature.settings.SettingsActivity" />
        </activity>

        <!-- Blocked notifications inbox -->
        <activity
            android:name=".feature.inbox.BlockedInboxActivity"
            android:exported="false"
            android:label="@string/blocked_inbox_title"
            android:parentActivityName=".feature.settings.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".feature.settings.SettingsActivity" />
        </activity>

        <!-- External QR/deep-link scanner entry point. Shows confirmation, then forwards as QR action. -->
        <activity
            android:name=".feature.qr.ExternalQrActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Switchly">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="switchly" android:host="switch" android:pathPattern=".*" />
                <data android:scheme="switchly" android:host="profile" android:pathPattern=".*" />
            </intent-filter>
        </activity>

        <!-- QR Scanner -->
        <activity
            android:name=".feature.qr.QrScanActivity"
            android:exported="false" />

        <!-- Barcode Scanner -->
        <activity
            android:name=".feature.barcode.BarcodeScanActivity"
            android:exported="false" />

        <!-- QR Generator -->
        <activity
            android:name=".feature.qr.QrGenerateActivity"
            android:exported="false" />

        <!-- What's new (release notes) -->
        <activity
            android:name=".feature.about.WhatsNewActivity"
            android:exported="false"
            android:label="@string/settings_changelog_title"
            android:parentActivityName=".feature.settings.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".feature.settings.SettingsActivity" />
        </activity>

        <!-- Support -->
        <activity
            android:name=".feature.support.SupportActivity"
            android:exported="false"
            android:label="@string/support_title"
            android:parentActivityName=".feature.settings.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".feature.settings.SettingsActivity" />
        </activity>
        
        <!-- Screen Time Dashboard -->
        <activity
            android:name=".feature.usage.ScreenTimeDashboardActivity"
            android:exported="false" />

        <!-- Screen Time Detail -->
        <activity
            android:name=".feature.usage.ScreenTimeDetailActivity"
            android:exported="false" />

        <activity
            android:name=".feature.usage.WebsiteDetailActivity"
            android:exported="false" />

        <!-- Manage Blocked Websites -->
        <activity
            android:name=".feature.settings.ManageBlockedWebsitesActivity"
            android:exported="false" />

        <!-- InApp Blocking -->
        <activity
            android:name=".feature.settings.InAppBlockingActivity"
            android:exported="false" />

        <!-- Manage Paired Tags -->
        <activity
            android:name=".feature.settings.ManagePairedTagsActivity"
            android:exported="false" />

        <!-- Manage barcodes -->
        <activity
            android:name=".feature.settings.ManageBarcodesActivity"
            android:exported="false" />

        <activity
            android:name=".feature.settings.AppLockSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".feature.settings.AppLockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Switchly" />

        <!-- App Info -->
        <activity
            android:name=".feature.about.AppInfoActivity"
            android:exported="false" />

        <!-- Device Info -->
        <activity
            android:name=".feature.about.DeviceInfoActivity"
            android:exported="false" />
            
        <!-- Developer Info -->
        <activity
            android:name=".feature.about.OtherSwitchlyProductsActivity"
            android:exported="false" />
        <activity
            android:name=".feature.about.DeveloperInfoActivity"
            android:exported="false" />

        <!-- Package Added Receiver -->
        <receiver
            android:name=".platform.receiver.apps.PackageAddedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- re-register watcher after app updates -->
        <receiver
            android:name=".platform.receiver.system.PostUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- restart watcher after device reboot -->
        <receiver
            android:name=".platform.receiver.system.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Replan schedules when system time/timezone changes -->
        <receiver
            android:name=".platform.receiver.system.TimeChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Reschedule exact alarms after the user grants the special access -->
        <receiver
            android:name=".platform.receiver.system.ExactAlarmPermissionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Re-evaluate schedules when device is unlocked/user becomes present -->
        <receiver
            android:name=".platform.receiver.system.UserUnlockReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>

        <!-- Geofence receiver (location-based schedules) -->
        <receiver
            android:name=".platform.receiver.location.LocationGeofenceReceiver"
            android:exported="false" />

        <!-- Schedule receiver (triggered via explicit PendingIntent) -->
        <receiver
            android:name=".platform.receiver.schedule.ScheduleReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- QS tile -->
        <service
            android:name=".platform.tile.SwitchlyTileService"
            android:exported="true"
            android:icon="@drawable/app_blocking_white_24"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Scanner Quick Settings tiles -->
        <service
            android:name=".platform.tile.QrScanTileService"
            android:exported="true"
            android:icon="@drawable/qs_qr_24"
            android:label="@string/qr_scan_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".platform.tile.BarcodeScanTileService"
            android:exported="true"
            android:icon="@drawable/qs_barcode_24"
            android:label="@string/barcode_scan_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.QuickActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.ScannerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_scanner_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scanner_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.QrScanWidgetProvider"
            android:exported="true"
            android:label="@string/widget_qr_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/qr_scan_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BarcodeScanWidgetProvider"
            android:exported="true"
            android:label="@string/widget_barcode_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/barcode_scan_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NfcWriteWidgetProvider"
            android:exported="true"
            android:label="@string/widget_nfc_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nfc_write_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.FocusNowWidgetProvider"
            android:exported="true"
            android:label="@string/widget_focus_now_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_now_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BlockedNotificationsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_blocked_notifications_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/blocked_notifications_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PauseBlockerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_pause_blocker_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pause_blocker_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NextScheduleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_next_schedule_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="at.saltyy.switchly.schedule.NEXT_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_schedule_widget_info" />
        </receiver>

        <!-- Accessibility based blocker -->
        <service
            android:name=".blocking.SwitchlyAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/switchly_accessibility_config" />
        </service>

        <!-- Notification blocker (hides notifications from blocked apps; requires notification listener access) -->
        <service
            android:name=".blocking.NotificationBlockerService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Wi-Fi trigger service -->
        <service
            android:name=".platform.receiver.wifi.WifiTriggerService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Bluetooth trigger service -->
        <service
            android:name=".platform.receiver.bluetooth.BluetoothTriggerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Bluetooth based profile triggers -->
        <receiver
            android:name=".platform.receiver.bluetooth.BluetoothConnectionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
