        </receiver>

        <!-- Home-screen widget for blocked notifications -->
        <receiver
            android:name=".widget.BlockedNotificationsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_blocked_notifications_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/blocked_notifications_widget_info" />
        </receiver>

        <!-- Home-screen widget for pausing the blocker -->
        <receiver
            android:name=".widget.PauseBlockerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_pause_blocker_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pause_blocker_widget_info" />
        </receiver>

        <!-- Home-screen widget for the next scheduled action -->
        <receiver
            android:name=".widget.NextScheduleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_next_schedule_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="at.saltyy.switchly.schedule.NEXT_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_schedule_widget_info" />
        </receiver>

        <!-- Home-screen widget showing the current active Switchly timer -->
        <receiver
            android:name=".feature.widget.ActiveTimerWidgetProvider"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/widget_active_timer_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_active_timer_info" />
        </receiver>

        <!-- Accessibility service used for app and website blocking -->
        <service
            android:name=".blocking.SwitchlyAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/switchly_accessibility_config" />
        </service>

        <!-- Notification listener service used to hide notifications from blocked apps -->
        <service
            android:name=".blocking.NotificationBlockerService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Foreground service for Wi-Fi based profile triggers -->
        <service
            android:name=".platform.receiver.wifi.WifiTriggerService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Foreground service for Bluetooth based profile triggers -->
        <service
            android:name=".platform.receiver.bluetooth.BluetoothTriggerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Bluetooth connection receiver for profile trigger updates -->
        <receiver
            android:name=".platform.receiver.bluetooth.BluetoothConnectionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for sharing exported backups, logs, and support files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
