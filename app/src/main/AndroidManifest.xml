<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for Firebase authentication, cloud sync, and remote resources -->

    <!-- Google Play Billing for Play Store Premium purchases -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Usage access for screen-time statistics and app blocking decisions -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Network-state checks for Firebase and sync logic -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wi-Fi state access for Wi-Fi schedules and triggers -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Android 13+ nearby Wi-Fi access without location derivation -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- Legacy Bluetooth permissions for Android 11 and lower -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12+ Bluetooth connection access -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />

    <!-- Location access needed to read Wi-Fi SSID and evaluate location schedules -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Exact alarms for schedules on Android 12+ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Background location improves Wi‑Fi trigger reliability when the app is not in the foreground.
         We request it in a 2‑step flow: first "While using the app", then guide the user to "Allow all the time". -->
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:targetApi="29" />

    <!-- Restart blockers, schedules, and widgets after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- NFC tag reading and writing -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- Notification runtime permission on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground services for blocking and trigger monitoring -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 14+ permission for Bluetooth connected-device foreground service type -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />

    <!-- Optional direct Android popup for allowing unrestricted background/battery behavior. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:ignore="BatteryLife" />

    <!-- Optional background-process kill attempts for stronger blocking cleanup -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Camera access for QR and barcode scanning -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Camera hardware is optional so Switchly can install on devices without a camera -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- NFC hardware is optional so Switchly can install on devices without NFC -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- Query launchable apps for the App rules picker -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- Supported in-app blocking targets used for picker shortcuts and installation checks. -->
        <package android:name="com.google.android.youtube" />
        <package android:name="com.instagram.android" />
        <package android:name="com.twitter.android" />
        <package android:name="com.snapchat.android" />
    </queries>

    <application
        android:name=".app.App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Switchly"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!-- Optional legacy HTTP library required by some Google Maps/Play Services modules -->
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <!-- Device-admin receiver for Advanced Mode/strict protection -->
        <receiver
            android:name=".receiver.DPMReceiver"
            android:exported="true"
            android:label="@string/advanced_mode_admin_label"
            android:description="@string/advanced_mode_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/switchly_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Main launcher activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent entry point for QR, barcode, NFC-write, and blocked-notification shortcuts -->
        <activity
            android:name=".feature.entry.ScanLauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="at.saltyy.switchly.action.OPEN_QR_SCAN" />
                <action android:name="at.saltyy.switchly.action.OPEN_BARCODE_SCAN" />
                <action android:name="at.saltyy.switchly.action.OPEN_NFC_WRITE" />
                <action android:name="at.saltyy.switchly.action.OPEN_BLOCKED_NOTIFICATIONS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings root screen -->
        <activity
            android:name=".feature.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings" />

        <!-- Blocking hub screen -->
        <activity
            android:name=".feature.tools.BlockingHubActivity"
            android:exported="false"
            android:label="@string/nav_blocking" />

        <!-- Tools/manage hub screen -->
        <activity
            android:name=".feature.tools.ToolsHubActivity"
            android:exported="false"
            android:label="@string/nav_tools" />

        <!-- Schedule management screen -->
        <activity
            android:name=".feature.schedule.SchedulesActivity"
            android:exported="false"
            android:label="@string/schedules_title"
            android:parentActivityName=".feature.settings.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".feature.settings.SettingsActivity" />
        </activity>

        <!-- Map picker for location-based schedules -->
        <activity
            android:name=".feature.schedule.LocationMapPickerActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:label="@string/schedules_location_map_picker_title"
            android:parentActivityName=".feature.schedule.SchedulesActivity" />

        <!-- First-run onboarding flow -->
        <activity
            android:name=".feature.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.Switchly" />

        <!-- Profile management screen -->
        <activity
            android:name=".feature.profiles.ManageProfilesActivity"
            android:exported="false" />

        <!-- App rules picker screen -->
        <activity
            android:name=".feature.picker.AppPickerActivity"
            android:exported="false" />

        <!-- Key/code management hub -->
        <activity
            android:name=".feature.tools.ManageKeysActivity"
            android:exported="false" />

        <!-- NFC action tag writer -->
        <activity
            android:name=".nfc.NfcWriterActivity"
            android:exported="false"
            android:theme="@style/Theme.Switchly" />

        <!-- NFC write waiting screen -->
        <activity
            android:name=".nfc.NfcWriteWaitingActivity"
            android:exported="false"
            android:theme="@style/Theme.Switchly" />

        <!-- NFC dispatch activity for Switchly NDEF and fallback tag scans -->
        <activity
            android:name=".nfc.NfcEntryActivity"
            android:exported="true"
            android:launchMode="singleTop">

            <!-- Broad Switchly URI dispatch for OEM NFC launch pickers such as HyperOS. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="switchly" />
            </intent-filter>

            <!-- NFC NDEF discovered pointing to readable/alias Switchly action tags. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="switchly" />
                <data android:host="action" />
            </intent-filter>

            <!-- NFC NDEF discovered pointing to legacy switchly://switch/... tags. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="switchly" />
                <data android:host="switch" />
            </intent-filter>

            <!-- NFC NDEF discovered pointing to legacy switchly://profile/... tags. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="switchly" />
                <data android:host="profile" />
            </intent-filter>

            <!-- Tech-discovered fallback for cards/tags that are claimed earlier than TAG_DISCOVERED for example IsoDep bank cards and some external/read-only tags). -->
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />

            <!-- Fallback for blank/non-NDEF tags so Switchly can still react. -->
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

