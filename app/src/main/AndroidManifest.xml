        </activity>

        <!-- Blocked notification inbox -->
        <activity
            android:name=".feature.inbox.BlockedInboxActivity"
            android:exported="false"
            android:label="@string/blocked_inbox_title"
            android:parentActivityName=".feature.settings.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".feature.settings.SettingsActivity" />
        </activity>

        <!-- External QR/deep-link confirmation entry point -->
        <activity
            android:name=".feature.qr.ExternalQrActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Switchly">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="switchly" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="switchly" />
                <data android:host="action" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="switchly" />
                <data android:host="switch" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="switchly" />
                <data android:host="profile" />
            </intent-filter>
        </activity>

        <!-- QR scanner screen -->
        <activity
